# ===== 目标设备: CETRON CT3003 (mediatek/filogic, mt7981) - U-Boot mod 版 =====
# 设备符号经 immortalwrt 23.05 源码 mediatek/image/filogic.mk 核实:
#   cetron_ct3003-stock / cetron_ct3003-ubootmod
# 此处选用 -ubootmod 变体（适配已刷第三方 U-Boot 的分区布局，可突破原厂容量限制）。
# 若路由器仍是原厂分区（未刷 U-Boot），请改用 cetron_ct3003-stock.config，否则可能变砖。
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_cetron_ct3003-ubootmod=y

# ===== 基础 Web 管理 (Luci) =====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y

# ===== 用户指定插件 =====
# -- luci-app-ssr-plus (来自 diy-part1.sh 添加的 fw876/helloworld 源；下面 INCLUDE 为可选协议，按需删减) --
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_V2ray=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Kcptun=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NaiveProxy=n

# -- luci-app-frpc (immortalwrt 自带) --
CONFIG_PACKAGE_luci-app-frpc=y

# -- luci-app-ngrokc (immortalwrt 自带；依赖 ngrokc 客户端，同样自带) --
CONFIG_PACKAGE_luci-app-ngrokc=y

# ===== 常用增强（可按需删减，节省空间） =====
CONFIG_PACKAGE_luci-app-ttyd=n
CONFIG_PACKAGE_luci-app-uhttpd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_curl=y

# 注意：ubootmod 分区通常更充裕，ssr-plus 全套一般无压力；仍可按需精简 INCLUDE_* 行。
