# ===== 目标设备: DomyWifi DW33D (ath79/nand, QCA9558) =====
# 经 immortalwrt 23.05 源码 ath79/image/nand.mk 核实：
#   define Device/domywifi_dw33d  (DEVICE_VENDOR := DomyWifi, DEVICE_MODEL := DW33D)
# 注意：DW33D 是 ath79（QCA9558）设备，subtarget 为 nand，并非 ipq40xx。
# DTS: target/linux/ath79/dts/qca9558_domywifi_dw33d.dts
# 正确的 .config 设备符号格式为 CONFIG_TARGET_<target>_<subtarget>_DEVICE_<device>=y。
CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_nand=y
CONFIG_TARGET_ath79_nand_DEVICE_domywifi_dw33d=y

# ===== 基础 Web 管理 (Luci) =====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_libustream-mbedtls=n
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y

# ===== 用户指定插件 =====
# -- luci-app-ssr-plus (来自 diy-part1.sh 添加的 fw876/helloworld 源；下面 INCLUDE 为可选协议，按需删减) --
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Client=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_MosDNS=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_V2ray=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Kcptun=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NaiveProxy=n

# -- luci-app-frpc (immortalwrt 自带) --
CONFIG_PACKAGE_luci-app-frpc=y

# -- luci-app-ngrokc (immortalwrt 自带；依赖 ngrokc 客户端，同样自带) --
CONFIG_PACKAGE_luci-app-ngrokc=y

# ===== 常用增强（可按需删减，节省空间） =====
CONFIG_PACKAGE_luci-app-ttyd=n
CONFIG_PACKAGE_luci-app-uhttpd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_curl=y
