# ===== 目标设备: EZVIZ CS-W3-WD1200G (W3 监控级全千兆双频路由) =====
# 平台: ipq40xx / IPQ4018 (4x Cortex-A7 @716MHz) + 128MB DDR3 (Nanya NT5CC64M16GP-DI)
# 原厂 SPI-NOR: 16MB (Macronix MX25L12805D) -- 本 config 对应【已换 32MB 芯片】的机器
#
# ⚠️⚠️ 重要：本 config 只适用于【已物理更换 32MB SPI-NOR】的机器。
#      原厂 16MB 的机器刷入会因分区越界直接变砖（firmware 分区写到 16MB 之外）。
#
# 32MB 布局由 scripts/diy-part2.sh 第 16 段注入（编译期改源码，不改上游设备名）：
#   · DTS  target/linux/ipq40xx/files/arch/arm/boot/dts/qcom-ipq4018-cs-w3-wd1200g-eup.dts
#          firmware 分区 0x00180000 + 0x00E80000 (14.5MiB) -> 0x00180000 + 0x01E80000 (30.5MiB)
#          0x180000 + 0x1E80000 = 0x2000000 = 32MiB，正好吃到芯片末尾
#   · generic.mk  IMAGE_SIZE  14848k -> 31232k （0x1E80000 = 31232 KiB，与分区严格对齐）
#
# 设备符号沿用 upstream 的 ezviz_cs-w3-wd1200g-eup，【不能改名】：
#   BOARD_NAME 决定 ipq-wifi BDF 包名，且 DTS 里
#   qcom,ath10k-calibration-variant = "ezviz-cs-w3-wd1200g-eup" 决定驱动加载哪个
#   board-*-ezviz_cs-w3-wd1200g-eup 校准文件。改名会导致 BDF 找不到，Wi-Fi 功率/校准退化。
#
# 分区前段（SBL1/MIBIB/QSEE/CDT/DDRPARAMS/APPSBLENV/APPSBL/ART）全部保持不动：
#   0x00000000 ~ 0x00180000，共 1.5MB。换芯片时必须把原片这 1.5MB 原样烧到新片同位置。
CONFIG_TARGET_ipq40xx=y
CONFIG_TARGET_ipq40xx_generic=y
CONFIG_TARGET_ipq40xx_generic_DEVICE_ezviz_cs-w3-wd1200g-eup=y

# ===== 基础 Web 管理 (Luci) =====
# immortalwrt 23.05 的 include/target.mk 默认带 libustream-openssl，
# 必须用 luci-ssl-openssl，否则与 luci-ssl(mbedtls) 的 libustream-ssl.so 冲突
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_libustream-mbedtls=n
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y

# ===== luci-app-ssr-plus（fw876/helloworld 源，仅保留 Xray 核心）=====
# 内存/体积考量：128MB RAM 上每多一个核心都是负担，只留 Xray（vless+reality 用它）
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_V2ray=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Kcptun=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_MosDNS=n
# SSR Libev 客户端体积很小(~200KB)，留着兼容老 SSR 节点；Rust 版一律关（会拉整套 rust 工具链）
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Server=n

# ===== luci-app-ngrokc（immortalwrt 官方 feeds 自带，依赖 libopenssl，勿删 openssl）=====
CONFIG_PACKAGE_luci-app-ngrokc=y

# ===== Wi-Fi 驱动：ath10k-ct smallbuffers 变体 =====
# 关键：IPQ4018 的 2.4G/5G 都由 SoC 出，两套 ath10k radio 的 firmware + ring buffer
# 常驻内存是这台机器最大的内存开销（默认 buffer 约 35MB，smallbuffers 约 15MB）。
# 上游 generic.mk 的 DEVICE_PACKAGES 已写死 `-kmod-ath10k-ct kmod-ath10k-ct-smallbuffers`，
# 这里再显式固化一次，防止 make defconfig 把 VARIANT 翻回默认的 regular buffer。
# 代价：5GHz 峰值吞吐 494/432 Mbps -> 438/343 Mbps（对 128MB 机器这笔买卖划算）
CONFIG_PACKAGE_kmod-ath10k-ct=n
CONFIG_PACKAGE_kmod-ath10k-ct-smallbuffers=y

# ===== 内存优化：砍 IPv6 双栈（128MB 上 odhcpd+odhcp6c 常驻约 3-5MB）=====
CONFIG_PACKAGE_odhcp6c=n
CONFIG_PACKAGE_odhcpd-ipv6only=n

# ===== dnsmasq-full：ssr-plus 的 ipset 分流依赖 full 版（精简版无 ipset 支持）=====
CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_dnsmasq-full=y

# ===== zram：128MB 内存的保险丝 =====
# 不用 zram-swap 包（它硬编码 RAM/2=64MB，对 128MB 机器反而挤占物理内存），
# 改用 diy-part2 第 16 段注入的 /etc/init.d/zramswap：固定 32MB disksize，
# 压缩后实际物理占用约 10-14MB，收益远大于代价。
# 注意：zram 用 CPU 换内存，A7@716MHz 压缩吞吐有限，只作应急缓冲，别当主内存用。
CONFIG_PACKAGE_kmod-zram=y

# ===== 精简：砍掉用不上的增强项 =====
CONFIG_PACKAGE_luci-app-ttyd=n
CONFIG_PACKAGE_luci-app-uhttpd=n
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_luci-app-frpc=n

# ===== 说明 =====
# 32MB 分区下大致配额：kernel <= 6MB（KERNEL_SIZE 未改）+ rootfs 其余，
# 总 IMAGE_SIZE 31232k(=30.5MiB)，装完基础系统 + ssr-plus + xray 后预计还剩 12-15MB 给 overlay，
# 比原厂 16MB 布局（overlay 仅约 3MB）宽裕得多。
