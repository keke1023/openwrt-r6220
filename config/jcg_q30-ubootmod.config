# ===== 目标设备: JCG Q30 / Q30 Pro (mediatek/filogic, mt7981) - custom U-Boot 布局版 =====
# 经 immortalwrt 23.05 源码 mediatek/image/filogic.mk 核实，Q30 共有**两个**设备定义：
#   ① define Device/jcg_q30              DEVICE_VARIANT := (OpenWrt U-Boot layout)
#      · KERNEL_IN_UBI / UBOOTENV_IN_UBI
#      · IMAGES := sysupgrade.itb（只有 itb）
#      · ARTIFACTS := preloader.bin + bl31-uboot.fip（自带官方 U-Boot 刷机件）
#   ② define Device/jcg_q30-ubootmod     DEVICE_VARIANT := (custom U-Boot layout)
#      · IMAGES += factory.bin（append-ubi + check-size 113152k）
#      · IMAGE/sysupgrade.bin := sysupgrade-tar | append-metadata
#      · 无 ARTIFACTS，适配**已刷第三方 U-Boot**（hanwckf/bl-mt798x 等）的分区布局
# 两者的 DTS 不同（mt7981b-jcg-q30 / mt7981b-jcg-q30-ubootmod），分区布局互不兼容：
#   ⚠️ 已刷第三方 U-Boot → 用本配置（-ubootmod）；仍是原厂/OpenWrt 官方 U-Boot → 用 jcg_q30.config。
#   ⚠️ 两者固件**不可互刷**（factory.bin 不能喂官方 U-Boot 的 web 恢复，itb 也不能喂第三方 U-Boot）。
# 本变体通过 DEVICE_ALT 机制同样覆盖 JCG Q30 Pro 与 CMCC MR3000D-CIq（同一硬件）。
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_jcg_q30-ubootmod=y

# ===== 基础 Web 管理 (Luci) =====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_libustream-mbedtls=n
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y

# ===== 用户指定插件 =====
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Client=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_MosDNS=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_V2ray=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Kcptun=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-app-ngrokc=y

# ===== 常用增强（可按需删减，节省空间） =====
CONFIG_PACKAGE_luci-app-ttyd=n
CONFIG_PACKAGE_luci-app-uhttpd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_curl=y
