# =============================================================================
# FriendlyARM NanoPi R2S —— OpenWrt 主线验证版配置
# =============================================================================
# 目的：验证 Linux 6.12 内树 r8152 驱动能否解决 RTL8153B USB 网口卡死问题
#
# 与 23.05 正式版（config/friendlyarm_nanopi-r2s.config）的关键区别：
#   1. 源码为 OpenWrt 官方主线（v25.12.x / kernel 6.12），不是 immortalwrt 23.05（5.15）
#   2. 用内树 kmod-usb-net-rtl8152，【不】用 kmod-usb-net-rtl8152-vendor
#   3. 不注入任何调优脚本 / 守护脚本 —— 保持裸驱动，做干净对照
#   4. 含 luci-app-ssr-plus（用户日常必需），但【不】加任何 r8152 相关补丁/调优
#
# ssr-plus 在 25.12 上的三个特有约束（已逐条核对源码，别再踩）：
#   a) luci.mk 只给带 luasrc/ 的应用自动加 +luci-lua-runtime，【不会】连带
#      luci-compat；而 CBI（luci.cbi）在 compat 里 → 缺了它页面直接 404/空白。
#      故必须显式 CONFIG_PACKAGE_luci-compat=y。
#   b) 25.12 默认 firewall4 → ssr-plus 的透明代理后端必须选 Nftables 那支
#      （Iptables 支会 select iptables-zz-legacy + ipset，与 fw4 冲突）。
#   c) aarch64 上 Shadowsocks 客户端/服务端的默认 choice 是 Rust 版，而
#      workflow 已把 shadowsocks-rust 依赖剥离 → 必须显式改选 libev / none，
#      否则 choice 指向一个不存在的依赖包。
#
# 另外 helloworld 克隆到 package/ 后，官方 packages 源里的 xray-core /
# v2ray-core / v2raya / microsocks 会构成重名包，由 workflow 在 defconfig 前删除。
#
# 为什么 6.12 值得试（Douglas Anderson 在 2023-09/10 提交的一组健壮性修复，
# 全部落在 v6.7 并 backport 到 v6.5.10+，但【没有】backport 到 5.15 LTS）：
#   a5feba71  r8152: Increase USB control msg timeout to 5000ms as per spec
#   34d29645  r8152: Block future register access if register access fails
#             -> 引入 r8152_control_msg() 封装 + rtl_set_inaccessible()
#             -> 寄存器访问失败【立即封锁所有后续访问】，防止驱动把 0xFF 垃圾
#                经 read-modify-write 写回芯片（commit 原文：
#                "Writing back modified garbage like this can fully wedge the
#                 adapter, requiring a power cycle." —— 正是我们的现象）
#             -> REGISTER_ACCESS_MAX_RESETS = 3，避免无限复位风暴
#   833dcd75  r8152: add netif_trans_update() in tx timeout（治 TX 队列假超时）
# =============================================================================

CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_friendlyarm_nanopi-r2s=y

# ----- Web 管理（方便登录观察 / 抓状态）-----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# ----- 诊断工具（验证阶段必需）-----
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_kmod-usb-utils=y

# ----- 验证目标：内树 r8152（6.12 主线版本）-----
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152-vendor=n

# ----- luci-app-ssr-plus（来自 fw876/helloworld master）-----
# luci-compat：Lua CBI 运行时，缺它 ssr-plus 页面全废（见文件头说明 a）
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-app-ssr-plus=y

# 透明代理后端：25.12 是 firewall4，只能 nftables（见说明 b）
CONFIG_PACKAGE_luci-app-ssr-plus_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-ssr-plus_Iptables_Transparent_Proxy=n

# 核心出口：Xray（reality / vision 都靠它）
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NONE_V2RAY=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_V2ray=n

# Shadowsocks 客户端：libev（Rust 已剥离，且 aarch64 默认会选 Rust，必须显式改，见说明 c）
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Client=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_NONE_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Client=n

# Shadowsocks 服务端：一律不装（本机不对外提供服务）
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_NONE_Server=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Server=n

# SSR 客户端保留（老节点订阅还要用），服务端不装
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Server=n

# 其余协议/插件：全部关闭，先把体积和变量压到最少
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Simple_Obfs=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_V2ray_Plugin=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_DNS2SOCKS=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_DNS2SOCKS_RUST=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ChinaDNS_NG=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_DNSPROXY=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_MosDNS=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Hysteria=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Tuic_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadow_TLS=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_IPT2Socks=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Kcptun=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Redsocks2=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan=n

# nftset 透明代理需要 dnsmasq-full（select 也会拉，但显式写死更稳）
CONFIG_PACKAGE_dnsmasq-full=y

# ----- SD 卡 rootfs 分区调大（与 23.05 正式版一致，给 overlay 留空间）-----
CONFIG_TARGET_ROOTFS_PARTSIZE=512
