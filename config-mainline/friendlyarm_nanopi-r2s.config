# =============================================================================
# FriendlyARM NanoPi R2S —— OpenWrt 主线验证版配置
# =============================================================================
# 目的：验证 Linux 6.12 内树 r8152 驱动能否解决 RTL8153B USB 网口卡死问题
#
# 与 23.05 正式版（config/friendlyarm_nanopi-r2s.config）的关键区别：
#   1. 源码为 OpenWrt 官方主线（v25.12.x / kernel 6.12），不是 immortalwrt 23.05（5.15）
#   2. 用内树 kmod-usb-net-rtl8152，【不】用 kmod-usb-net-rtl8152-vendor
#   3. 不注入任何调优脚本 / 守护脚本 —— 保持裸驱动，做干净对照
#   4. 不含 ssr-plus / xray / frpc 等第三方 feeds 包（减少变量，先只验证驱动）
#
# 为什么 6.12 值得试（Douglas Anderson 在 2023-09/10 提交的一组健壮性修复，
# 全部落在 v6.7 并 backport 到 v6.5.10+，但【没有】backport 到 5.15 LTS）：
#   a5feba71  r8152: Increase USB control msg timeout to 5000ms as per spec
#   34d29645  r8152: Block future register access if register access fails
#             -> 引入 r8152_control_msg() 封装 + rtl_set_inaccessible()
#             -> 寄存器访问失败【立即封锁所有后续访问】，防止驱动把 0xFF 垃圾
#                经 read-modify-write 写回芯片（commit 原文：
#                "Writing back modified garbage like this can fully wedge the
#                 adapter, requiring a power cycle." —— 正是我们的现象）
#             -> REGISTER_ACCESS_MAX_RESETS = 3，避免无限复位风暴
#   833dcd75  r8152: add netif_trans_update() in tx timeout（治 TX 队列假超时）
# =============================================================================

CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_friendlyarm_nanopi-r2s=y

# ----- Web 管理（方便登录观察 / 抓状态）-----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# ----- 诊断工具（验证阶段必需）-----
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_kmod-usb-utils=y

# ----- 验证目标：内树 r8152（6.12 主线版本）-----
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152-vendor=n
