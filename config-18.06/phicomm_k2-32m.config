# ===== 目标设备: Phicomm K2 32M (ramips / mt7620, MT7620A, 32MB SPI-NOR) =====
# 分支：immortalwrt openwrt-18.06-k5.4（REPO_URL=immortalwrt/immortalwrt）
#
# 上游 18.06-k5.4 的 mt7620.mk 只有 8MB 版：
#   phicomm_k2-v22.4 (IMAGE_SIZE 7872k, firmware 0x50000+0x7b0000)
#   phicomm_k2-v22.5 (7552k, 带 permanent_config → firmware 0xa0000)
#   phicomm_psg1218b (7872k)
# 无 32MB 变体，故由 scripts/diy-part2.sh 第 15 段注入三件套：
#   ① DTS mt7620a_phicomm_k2_32m.dts（脚本按 dtsi 是否含 pa_gpio_pins 自动选 23.05 / 18.06 版本）
#   ② mt7620.mk 设备定义（SOC=mt7620a，显式 DEVICE_DTS 避开默认名带连字符）
#   ③ board.d/02_network 的 interfaces + macs 分支（MT7620 是 swconfig，无 *) 兜底）
#
# firmware 分区：起始 0x50000（紧接 factory 之后，与原厂 v22.4 一致，不设 permanent_config），
#   大小 0x1fb0000（=32448 KiB，正好到 32MB 末尾）→ IMAGE_SIZE := 32448k。
#
# ⚠️ TLS 后端（沿用同分支已验证的 dw33d.config 写法）：
#   18.06-k5.4 的 DEFAULT_PACKAGES 把 libustream-mbedtls 作为默认 TLS 后端（设 =n 也压不住，
#   defconfig 后仍变回 =y），故保持 mbedtls 单后端；libustream-openssl 显式 =n，
#   避免两者同时提供 lib/libustream-ssl.so 导致 opkg 安装期 check_data_file_clashes 失败。
#
# ⚠️ 设备符号（铁律：CONFIG_TARGET_<target>_<subtarget>_DEVICE_<device>=y）
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y
CONFIG_TARGET_ramips_mt7620_DEVICE_phicomm_k2-32m=y

# ===== 编译/镜像（32MB 空间充足）=====
CONFIG_TARGET_OPTIMIZE_FOR_SIZE=y
CONFIG_TARGET_SQUASHFS_XZ=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_CCACHE=y

# ===== LuCI Web 管理 =====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-upnp=y

# ===== 管理基础 =====
CONFIG_PACKAGE_dropbear=y                 # SSH 服务端
CONFIG_PACKAGE_opkg=y                     # 包管理器 CLI
CONFIG_PACKAGE_dnsmasq-full=y             # ssr-plus 硬依赖 ipset，full 版不可降级

# ===== TLS 后端（mbedtls 单一；openssl 关掉避免双后端冲突）=====
CONFIG_PACKAGE_libustream-openssl=n
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_libmbedtls=y                # 连带 libmbedcrypto / libmbedx509

# ===== 代理插件（helloworld master 最新提交；Go 1.26 源码编译 xray）=====
# -- luci-app-ssr-plus --
CONFIG_PACKAGE_luci-app-ssr-plus=y
# 透明代理后端：18.06 系无 firewall4，choice 默认即 iptables；显式固化以保证依赖齐全
CONFIG_PACKAGE_luci-app-ssr-plus_Iptables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Client=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Simple_Obfs=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_DNS2SOCKS=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan_Plus=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_MosDNS=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_V2ray=n     # VLESS 用 Xray 即可，不编 V2Ray
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y      # VLESS 由 xray-core 提供
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Kcptun=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ChinaDNS_NG=y   # chinadns-ng（ssr-plus 集成开关）
# -- chinadns-ng 独立包 --
CONFIG_PACKAGE_chinadns-ng=y
# -- luci-app-frpc（immortalwrt 主源自带）--
CONFIG_PACKAGE_luci-app-frpc=y
# -- luci-app-ngrokc（immortalwrt 主源自带）--
CONFIG_PACKAGE_luci-app-ngrokc=y

# ===== 无线驱动 =====
#   内置 2.4G（MT7620A）由 mt7620 目标默认包 kmod-rt2800-soc 提供；
#   5G 为 PCIe 上的 MT7612E，需 kmod-mt76x2（与上游 phicomm_k2-v22.4 的 DEVICE_PACKAGES 一致）。
CONFIG_PACKAGE_kmod-mt76x2=y

# ===== 便利功能 =====
CONFIG_PACKAGE_luci-app-ttyd=n     # 不需要多余的 ttyd 终端

# ===== 18.06 系补丁：iptables-mod-socket 兼容包 =====
#   18.06 系没有独立的 iptables-mod-socket（socket match 合并在 iptables-mod-tproxy 里），
#   ssr-plus 的 init.d 自检会误报缺失。由 diy-part2.sh 第 16 段注入空元包补包名。
CONFIG_PACKAGE_iptables-mod-socket=y
