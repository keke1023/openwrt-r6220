# Phicomm K2P（ramips/mt7621）—— openwrt-18.06-k5.4 分支 · 小闪存精简版（仅 ss/vless，去 ssh/opkg/ssl）
#
# 分支隔离说明：
#   - 本文件放在独立的 config-18.06/ 目录，与 23.05 的 config/ 互不污染；
#     build.yml 的 prepare 会按所选 source_branch 自动选 config 或 config-18.06。
#   - openwrt-18.06-k5.4 是「18.06 包基础 + 5.4 新内核」，兼容 helloworld / ngrokc / frpc；
#     本 config 走「小闪存精简」路线：ssr-plus 只开 ss+vless、去 ssh/opkg/ssl、不编 frpc，但保留 ngrokc。
#     只有真正老内核的 openwrt-18.06（4.x）才会跳过 helloworld。
#   - 默认管理地址 192.168.6.1 由 scripts/diy-part2.sh 统一设置（sed 替换 192.168.1.1）。

CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_phicomm_k2p=y

# ===== 体积优化（小闪存关键） =====
CONFIG_TARGET_OPTIMIZE_FOR_SIZE=y        # 全局 -Os 编译，省空间
CONFIG_TARGET_SQUASHFS_XZ=y              # 镜像用 xz 压缩，比默认 gzip 明显更小

# ===== LuCI Web 管理（仅 http，去掉 ssl 省下 openssl/libustream ~1MB） =====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
# 不用 https：不编 luci-ssl / libustream，LuCI 走 http（本地管理足够；如需 https 还原下面两行）
# CONFIG_PACKAGE_luci-ssl-openssl is not set

# 明确剔除用户不需要的功能（ssh / opkg）
CONFIG_PACKAGE_dropbear=n                 # SSH 服务端
CONFIG_PACKAGE_opkg=n                     # 包管理器 CLI
CONFIG_PACKAGE_luci-app-opkg=n            # opkg 的 LuCI 前端

# CCACHE（workflow 也会再追加一次，这里写上也无害）
CONFIG_CCACHE=y

# ===== 用户指定插件：仅 ssr-plus，且只保留 ss(shadowsocks-libev) + vless(xray) =====
# -- luci-app-ssr-plus（来自 diy-part1.sh 添加的 fw876/helloworld 源） --
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Client=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_MosDNS=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_V2ray=n     # VLESS 用 Xray 即可，不编 V2Ray
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y      # VLESS 由 xray-core 提供
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Kcptun=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NaiveProxy=n

# -- 用户指定：保留 luci-app-ngrokc（内网穿透 GUI） --
CONFIG_PACKAGE_luci-app-ngrokc=y

# -- 不要 frpc：既不是 ssh/opkg，也不是 ss/vless 协议，且占空间 --
# CONFIG_PACKAGE_luci-app-frpc is not set
