# PHICOMM K2P（斐讯 K2P，MT7621A）—— openwrt-18.06-k5.4 分支
#   MT7621A / 128MB DDR3 / **16MB SPI NOR** / MT7615D（DBDC 单芯片双频 2.4G+5G）/
#   5×GE（1WAN+4LAN）/ 无 USB
#
# 本配置的目标：**无线可用 + ssr-plus(xray) + vless/reality**，且体积卡进 16MB。
#   - 无线走**开源 mt76**（kmod-mt7615e + mt7615-firmware），不用 MTK 闭源 mt_wifi：
#       闭源 kmod-mt7615d ≈ 1.4MB（mt_wifi.ko 3.5MB 源码，wireless-ext 私有 ioctl，
#       只能用它自带的 luci-app-mtwifi 配网）；开源 mt7615e 全家 ≈ 0.55MB，
#       走标准 mac80211，Luci 的「网络→无线」原生页面直接可用。
#       ❗ 本分支（openwrt-18.06-k5.4）**自带 package/kernel/mt76**（2021-10-23.1，
#         与 mac80211 backports 5.10.68 同代），无需从 21.02 搬运源码 —— 只改
#         DEVICE_PACKAGES 与 config 即可。见 diy-part2.sh 第 [18] 段。
#   - 整条 USB 链关闭（K2P 无 USB 口，且 16MB 没有 extroot 余量）
#   - ssr-plus 编 Xray 核心 + **Shadowsocks(libev) 客户端**（2026-11-01 回滚，SS 可能用到）；
#     SSR / Rust / obfs 插件仍关闭
#   - 硬件 offload 已启用（MT7621 PPE，fw3 下发 FLOWOFFLOAD --hw）
#
# ⚠️ 体积账（firmware 分区 IMAGE_SIZE=16064k，起点已从 0xa0000 前移到 0x50000，
#   见 scripts/diy-part2.sh 第 [19] 段，比 A3004NS 的 16128k 只少 64k）：
#
#   【2026-11-01 实测】镜像 15360k / 上限 16064k / overlay 703k（含告警：不足 1MiB）
#   ── 本轮改动（加 ngrokc + 三处裁剪，详见 diy-part2.sh 第 [20] 段）──
#   + luci-app-ngrokc + ngrokc + **libstdcpp**（大头）                            ≈ +400k
#   - ssr-plus 的 +ip-full 改 +ip-tiny（连带甩掉 libbpf0/libelf1）                 ≈ -130k
#   - mt7621 FEATURES 去 nand → 不再拉 ubi-utils                                  ≈ -50k
#   - kmod-mppe=n                                                                 ≈ -12k
#   - squashfs 块大小 256k -> 1024k（非砍包，纯压缩效率）                         ≈ -500~-1200k
#   ------------------------------------------------------------------------------
#   ≈ 15070~14470k → 留给 overlay ≈ 994~1594k（大概率越过 1MiB 线）
#
#   ❗ 为什么先动块大小而不是砍包（2026-11-01 用官方 18.06 索引 Installed-Size 实测）：
#      默认自带包里能砍的就那么几个，全砍完天花板也只有 ~200k，且要付出 SSH/拨号能力：
#        dropbear 84.3k（~35k squashfs）、ppp+ppp-mod-pppoe 104k（~45k）、
#        ca-bundle 112.8k（但它是 PEM 文本，squashfs 里只占 ~30k）
#      busybox 207.6k / netifd 59.7k / opkg 56.1k / base-files 52.2k 等必需项动不得；
#      kmod-crypto-* 一大串单个只有 1~5k，纯属 mt7621 默认包的 EIP93 加密链，掏不出东西。
#      结论：砍包性价比极低，块大小才是零功能代价的最大一刀。
#
#   ❗ 为什么没有「删 coreutils」这一刀（原本以为能省 450k，实测不成立）：
#      feeds 里 `Package/coreutils/install` 是 `true` —— 主包是空壳、不装任何文件，
#      真正内容在 coreutils-<applet> 子包里，且每个子包 `DEPENDS:=coreutils`（硬依赖）。
#      所以主包删不掉、也不占空间；当前镜像 coreutils 组只有 ≈35k。
#
#   ❗ 下一轮要补的一刀（这次没混进来，因为影响 curl/libustream 的 choice，需单独验证）：
#      把 TLS 双栈并成 openssl 单栈 —— curl 和 libustream 都切 openssl，干掉
#      libmbedtls12（≈250k squashfs）。default-settings 本来就硬依赖 openssl，
#      ngrokc 也要 openssl，所以 openssl 这半边无论如何都在，mbedtls 才是可去的那半。
#      做完 overlay 预计回到 ≈740k～800k。
#
#   若实测仍低于 1MiB，按顺序再砍（都是「用不到就关」的项）：
#     ① PPPoE（ppp/ppp-mod-pppoe/luci-proto-ppp ≈35k）——K2P 只当 AP/旁路由时不需要
#     ② Libev SS 栈（≈90k）——只用 xray 的 vless/trojan 时不需要
#     ③ luci-i18n-*-zh-cn（≈150k）——英文界面能接受的话
#     ④ wpad-basic → wpad-mini（≈40k）——只要 11n 不要 11ac 时
#   首版编完一律以真实 sysupgrade.bin 字节数为准。
#
# ⚠️ TLS 后端（18.06-k5.4 的坑）：libustream-mbedtls 为默认后端，libustream-openssl 必须 =n，
#   两者都提供 lib/libustream-ssl.so，同选会在 opkg 安装期 check_data_file_clashes 失败。
#
# ⚠️ 设备符号（铁律：CONFIG_TARGET_<target>_<subtarget>_DEVICE_<device>=y，subtarget 不可省）
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_phicomm_k2p=y

# ===== 镜像 =====
CONFIG_TARGET_OPTIMIZE_FOR_SIZE=y
CONFIG_TARGET_SQUASHFS_XZ=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# squashfs 块大小 256(默认) -> 1024 KiB。
#   上游 config/Config-images.in 的规则是：
#       default 1024 if (SMALL_FLASH && !LOW_MEMORY_FOOTPRINT)
#       default 256
#   本机型没开 SMALL_FLASH，所以一直吃 256 的默认值。块越大 xz 的压缩字典越大、
#   重复串命中的窗口越宽，同样内容镜像普遍小 3~8%（15360k -> 约 14300~14800k）。
#   ★ 这是唯一「一个包都不砍、纯粹变现」的瘦身项，收益比砍 dropbear/ppp 加起来还大。
#   代价：运行时解压单元从 256k 变 1M，MT7621（880MHz 双核）上首次读某文件会有
#         轻微延迟上升（通常几十 ms 级，交互体感差别很小）；额外占约 1MiB 内存
#         （K2P 有 128MB，可忽略）。
#   ❗ 显式写这一行而不是靠 CONFIG_SMALL_FLASH=y 去联动：SMALL_FLASH 还会顺带改
#      KERNEL_SQUASHFS_FRAGMENT_CACHE_SIZE 等其他默认值，不想被连带影响。
#   ❗ 改块大小不影响分区布局、不要求换刷机方式，sysupgrade 照常；
#      squashfs 变小后 overlay 会等量变大（overlay = 分区大小 - squashfs 大小）。
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=1024
# K2P 已有 OpenWrt/Breed 时 sysupgrade 即可，initramfs 不是必需；关掉可省一次全量编译。
# 若需要「从 Breed 直接刷」的 recovery 镜像，把它改回 =y。
CONFIG_TARGET_ROOTFS_INITRAMFS=n
CONFIG_CCACHE=y

# ===== LuCI（最小集：基础 + 防火墙 + 软件包管理）=====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_luci-app-frpc=n
# ngrokc：内网穿透（自带 ngrokc 1.55 + luci 前端）
#   ❗ 真实成本不止它自己：DEPENDS = libc libpthread libopenssl libstdcpp zlib，
#     其中 **libstdcpp（≈700K 安装 / ≈300K squashfs）当前不在镜像里**，这才是大头。
#   为它腾空间所做的四处裁剪见 scripts/diy-part2.sh 第 [20] 段。
CONFIG_PACKAGE_luci-app-ngrokc=y
CONFIG_PACKAGE_ngrokc=y
CONFIG_PACKAGE_luci-app-ttyd=n

# ===== 管理基础 =====
# dropbear 保留（=y）：同上，恢复 ss 栈只花 ~90KB，不需要用 SSH 换空间；
#   且 failsafe_netlogin() 依赖 dropbear（18.06 的 99_10_failsafe_login），
#   删掉后 failsafe 只剩串口。要删就把本行改 =n。
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_opkg=y
# ssr-plus 硬依赖 ipset，dnsmasq-full 不可降级为 dnsmasq
CONFIG_PACKAGE_dnsmasq-full=y

# ===== TLS 后端（单一 mbedtls）=====
CONFIG_PACKAGE_libustream-openssl=n
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_libmbedtls=y

# ===== 代理插件：helloworld 的 luci-app-ssr-plus（pin 到 a201839 / xray v1.8.24）=====
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_Iptables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_V2ray=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan_Plus=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Kcptun=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_MosDNS=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_DNS2SOCKS=n
# ❗ 这是 choice：Client 只能选一个。
#   2026-11-01 决定保留 **libev**（ss-local+ss-redir+libsodium+libev ≈251KB 安装 / ≈90KB squashfs），
#   因为 ss 协议仍可能用到；NONE_Client 必须删除或置 n，不能与 Libev 同时 =y，否则 kconfig 冲突。
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Client=y
# 服务端用不到 → NONE
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_NONE_Server=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Server=n
# SSR / Rust / obfs 仍关闭（要 SSR 就把下面第一行改 y，+≈100KB）
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Simple_Obfs=n
# ChinaDNS-NG 保留（分流用，ssr-plus 的硬依赖链）
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ChinaDNS_NG=y
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_xray-core=y

# 18.06 系补丁：iptables-mod-socket 兼容元包（diy-part2.sh 第16段注入空元包补名）
CONFIG_PACKAGE_iptables-mod-socket=y

# ===== 无线：闭源 mt7615d（mt_wifi 5.1.0.0）=====
#   2026-11-04 实机结论：开源 mt76（2021-10-23.1）对 MT7615D DBDC 热重启有 bug，
#   系统内 reboot 后 radio1 phy 消失 / radio0 HOSTAPD_START_FAILED，只能断电恢复，
#   无法正常使用 → 换回上游默认的闭源 kmod-mt7615d（热重启处理成熟）。
#   代价：squashfs +0.85MB（mt_wifi.ko ≈1.05MB + 内嵌 firmware 0.58MB，
#   减去省下的 mt76 全家）；LuCI 原生「无线」页为空，配网走 luci-app-mtwifi。
#   DEVICE_PACKAGES（kmod-mt7615d luci-app-mtwifi -wpad-openssl）由上游默认带入，
#   diy-part2.sh [18] 段已默认停用，无需再防 DEFAULT_PACKAGES 翻回。
CONFIG_PACKAGE_kmod-mt7615d=y
CONFIG_PACKAGE_luci-app-mtwifi=y
CONFIG_PACKAGE_kmod-mt7615e=n
CONFIG_PACKAGE_kmod-mt7615-firmware=n
#   开源 mt76 的 HIDDEN 内部包（mt76.ko / mt76-connac-lib.ko / mt7615-common.ko）
#   随 kmod-mt7615e=n 一并消失，无需显式 =n。
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-cfg80211=y
#   wpad：闭源驱动不使用 hostapd（mt_wifi 自带 AP 栈），但保留 wpad-basic 供
#   iwinfo/LuCI 状态页工作（省 100KB 的 openssl/wolfssl 变体继续关）。
CONFIG_PACKAGE_wpad-basic=y
CONFIG_PACKAGE_wpad-openssl=n
CONFIG_PACKAGE_wpad-wolfssl=n
CONFIG_PACKAGE_wpad=n
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_hostapd-common=y
CONFIG_PACKAGE_libiwinfo=y
CONFIG_PACKAGE_libiwinfo-lua=y
CONFIG_PACKAGE_libiwinfo-data=y
CONFIG_PACKAGE_iwinfo=y

# ===== 有线/拨号 =====
CONFIG_PACKAGE_swconfig=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y
# PPPoE：K2P 当主路由拨号时必须保留（ppp + ppp-mod-pppoe ≈ 105KB 安装体积）。
# 只当 AP / 旁路由时，把下面三行改成 =n 可再省约 35KB 镜像体积。
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y
# IPv6：本机自用不开（省 odhcp6c/odhcpd ≈ 30KB）。需要用 IPv6 时改 =y 并放开 ip6tables。
CONFIG_PACKAGE_odhcp6c=n
CONFIG_PACKAGE_odhcpd=n

# ===== USB：整条链全灭 =====
CONFIG_PACKAGE_kmod-usb-core=n
CONFIG_PACKAGE_kmod-usb2=n
CONFIG_PACKAGE_kmod-usb3=n
CONFIG_PACKAGE_kmod-usb-ehci=n
CONFIG_PACKAGE_kmod-usb-ohci=n
CONFIG_PACKAGE_kmod-usb-dwc2=n
CONFIG_PACKAGE_kmod-usb-storage=n
CONFIG_PACKAGE_kmod-usb-storage-extras=n
CONFIG_PACKAGE_kmod-usb-storage-uas=n
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=n
CONFIG_PACKAGE_kmod-usb-hid=n
CONFIG_PACKAGE_kmod-usb-net=n
CONFIG_PACKAGE_kmod-usb-serial=n
CONFIG_PACKAGE_usbutils=n
CONFIG_PACKAGE_usb-modeswitch=n
CONFIG_PACKAGE_libusb-1.0=n
CONFIG_PACKAGE_block-mount=n
CONFIG_PACKAGE_kmod-scsi-core=n
CONFIG_PACKAGE_kmod-fs-ext4=n
CONFIG_PACKAGE_kmod-fs-vfat=n
CONFIG_PACKAGE_kmod-fs-ntfs=n
CONFIG_PACKAGE_kmod-fs-f2fs=n
CONFIG_PACKAGE_e2fsprogs=n
CONFIG_PACKAGE_fdisk=n
CONFIG_PACKAGE_lsblk=n
CONFIG_PACKAGE_luci-app-hd-idle=n

# ===== 其它常见拖体积项：显式关掉 =====
CONFIG_PACKAGE_libustream-wolfssl=n
CONFIG_PACKAGE_libwolfssl=n
CONFIG_PACKAGE_luci-app-diskman=n
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-rclone=n
CONFIG_PACKAGE_luci-app-turboacc=n
CONFIG_PACKAGE_luci-app-filetransfer=n
CONFIG_PACKAGE_luci-lib-fs=n
CONFIG_PACKAGE_luci-app-cpufreq=n
# ubi-utils 是 FEATURES 带 nand 的机型默认包（K2P 是 SPI NOR，没有 UBI 卷）。
# ❗ 只写 =n 没用：mt7621 的 target.mk 里有 `FEATURES+=nand`，会让 include/target.mk
#   把 ubi-utils 塞进 DEFAULT_PACKAGES，defconfig 再把这里的 =n 覆盖回 =y
#   （2026-11-01 实测：manifest 里确实还有 ubi-utils - 2.1.2-1）。
#   真正生效的剔除在 scripts/diy-part2.sh 第 [20] 段（对 k2p.config 去掉 nand feature）。
CONFIG_PACKAGE_ubi-utils=n
# FTP/SIP/IRC/H.323 等 conntrack helper（kmod-nf-nathelper-extra ≈ 53KB）：家用不需要 ALG
CONFIG_PACKAGE_kmod-nf-nathelper-extra=n
# MPPE 是 PPTP/VPN 的 PPP 加密，PPPoE 拨号用不到（≈30KB 安装）
CONFIG_PACKAGE_kmod-mppe=n
# ip-full -> ip-tiny：tproxy 只用到 ip rule/ip route（ip-tiny 全支持），
#   顺带甩掉 ip-full 独占的 libbpf0 + libelf1（≈300KB 安装）。
#   ❗ 必须同时在 diy-part2.sh 第 [20] 段把 ssr-plus 的 `+ip-full` 改成 `+ip-tiny`，
#     否则 defconfig 会按 ssr-plus 的硬依赖把 ip-full 拉回来。
CONFIG_PACKAGE_ip-tiny=y
CONFIG_PACKAGE_ip-full=n

# =====================================================================================
# 转发性能 / offload（硬件 offload 已启用：自用机，不需要流量统计与 QoS）
# =====================================================================================
#   驱动侧：CONFIG_NET_RALINK_OFFLOAD=y（ralink/mtk_offload.c → mtk_eth_soc 注册 PPE 回调）
#   下发侧：fw3 flow_offloading_hw=1 → iptables -j FLOWOFFLOAD --hw
#   kmod-nf-flow 的 KCONFIG 会同时置位 CONFIG_NF_FLOW_TABLE(_HW)，缺 HW 时 --hw 静默退化。
#   代价（已知并接受）：卸载流量绕过 netfilter → 计数器/按 IP 统计失真；与 QoS 互斥。
#   ⚠️ 无线转发基本吃不到 PPE（FOE 只加速有线 FORWARD），别指望 5G 跑满千兆。
#   注入点见 diy-part2.sh 第 [17] 段（门控已含 k2p）。
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_kmod-nf-flow=y

# ===== 依赖自洽兜底：kmod-mii（不改体积，防打包阶段炸）=====
#   kmod-usb-net 的 DEPENDS 里有 +kmod-mii；本分支 generic/config-5.4 是 CONFIG_MII=y（内建），
#   mii.ko 不产出 → 只要有任何路径把 kmod-usb-net 拉进 .config 就 Error 1。
#   置 y 拆雷（内建时 install 只打印 NOTICE），USB 链本体仍全部 =n。
CONFIG_PACKAGE_kmod-mii=y

# ===== zram 应急缓冲（128MB 内存机型，2026-11-04 加入）=====
# 配合 diy-part2.sh [16b] 注入的 /etc/init.d/zramswap（32MB 盘，用到才占内存）。
# 实机 meminfo：闭源 mt_wifi SUnreclaim slab 20MB 不可回收 + xray RSS 10~20MB，
# MemAvailable 仅 ~17MB 且无 swap → 测速/多连接高峰 OOM killer 首选目标就是 xray。
# zram 是最后一道 OOM 保险；kmod-zram 依赖（压缩算法等）自动选上，squashfs +~80KB。
CONFIG_PACKAGE_kmod-zram=y
