# ZTE E8821（中兴 E8821，QCA9563）—— openwrt-18.06-k5.4 分支
#   QCA9563（单核 MIPS 24Kc，内置 2.4G 3×3 11n）/ QCA9882（PCIe 5G 2×2 11ac）/
#   QCA8337N（5×GE，1WAN+4LAN）/ 128MB DDR2 / **16MB SPI NOR（硬改，W25Q128 + breed）**
#
# 本配置的目标：无线可用 + ssr-plus(精简 xray 1.8.24) + vless/reality + ngrokc + 定时重启
#               + zram 应急缓冲，全部卡进 16MB。
#
# ⚠️ 与 wr1200js / k2p 的关键差异（别照抄它们）：
#   ① 这是 **ath79** 目标，不是 ramips。设备符号 = CONFIG_TARGET_ath79_generic_DEVICE_zte_e8821
#   ② QCA9563 **没有 PPE/HNAT 硬件 offload**（那是 MT7621 的东西），
#      所以本 config 不选 kmod-ipt-offload / kmod-nf-flow，diy-part2 [17] 段也不对本机生效。
#   ③ QCA9563 是**单核**：irqbalance 无意义，不要选；kmod-tcp-bbr 也未启用（无 [16d] 下发）。
#   ④ 无线是 ath10k-ct（闭源固件 + 开源驱动），不是 mt76，也不是 mt_wifi 闭源栈。
#      5G 校准由 11-ath10k-caldata 从 art 分区 0x5000 取 0x844 字节（9880/9882 格式）。
#   ⑤ wpad：ath79 generic 的 DEFAULT_PACKAGES 是 **wpad-basic-openssl**（不是 ramips 的
#      wpad-openssl），所以**不需要**给 DEVICE_PACKAGES 加 -wpad-openssl，也没有 PROVIDES 冲突。
#
# ⚠️ 设备定义/网络/LED/校准全部由 diy-part2.sh 第 [25] 段注入（上游 18.06-k5.4 没有这台机器）：
#     - DTS：scripts/qca9563_zte_e8821.dts → target/linux/ath79/dts/qca9563_zte_e8821.dts
#            骨架来自 OpenWrt master 的 qca9563_yuncore_xd3200.dts（同为 9882 + art 0x844）
#     - 设备：ath79/image/generic.mk 里追加 define Device/zte_e8821（IMAGE_SIZE 16000k）
#     - 网络：ath79/generic/base-files/etc/board.d/02_network 追加 zte,e8821 分支
#            "0@eth0" "1:lan" "2:lan" "3:lan" "4:lan" "5:wan"（QCA8337N 的 PHY1~5）
#     - 校准：ath79/generic/base-files/etc/hotplug.d/firmware/11-ath10k-caldata
#            把 zte,e8821 加进 asus,rp-ac66 / yuncore,a770 那一组（0x844）
#
# ⚠️ 体积账（IMAGE_SIZE=16000k = DTS firmware 分区 0x050000 + 0xfa0000）：
#     ath79 基础系统 + LuCI           ≈  4.0 MiB
#     ath10k-ct.ko + qca988x 固件     ≈  0.6 MiB   （固件压缩率低，是大头之一）
#     ssr-plus 全家（libev 版）        ≈  1.5 MiB
#     精简 xray 1.8.24                ≈  4.2 MiB   （[16c]/diy-part1 已砍 gRPC/quic/gvisor）
#     ngrokc + libstdcpp              ≈  0.35 MiB
#     其它（ppp/dnsmasq-full/iptables）≈  0.6 MiB
#     ------------------------------------------------
#     ≈ 11.3–12.5 MiB → overlay 约 1.5–2.0 MiB（越过 1 MiB 底线，但不要指望装大包）
#
# ⚠️ TLS 后端：18.06-k5.4 默认 libustream-mbedtls，libustream-openssl 必须 =n（同 PROVIDES，
#   同选会在打包期 check_data_file_clashes）。

# ===== 目标与设备（subtarget 不可省：ath79 下有 generic/nand/mikrotik/tiny）=====
CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_generic=y
CONFIG_TARGET_ath79_generic_DEVICE_zte_e8821=y

# ===== 镜像 =====
CONFIG_TARGET_OPTIMIZE_FOR_SIZE=y
CONFIG_TARGET_SQUASHFS_XZ=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# squashfs 块 256 -> 1024 KiB：零功能代价，镜像普遍小 3~8%（与 k2p/wr1200js 同一刀）
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=1024
CONFIG_TARGET_ROOTFS_INITRAMFS=n
CONFIG_CCACHE=y

# ===== LuCI（最小集：基础 + 防火墙）=====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
# 注：18.06 的 luci 源里**没有 luci-app-opkg**（那是 19.07+ 才拆出来的），
#   「软件包」页由 luci-mod-admin-full 提供，装了 opkg 就自动出现，无需额外选包。
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_luci-app-frpc=n
CONFIG_PACKAGE_luci-app-ttyd=n
# ngrokc：内网穿透（真实成本在 libstdcpp ≈300KB squashfs）
CONFIG_PACKAGE_luci-app-ngrokc=y
CONFIG_PACKAGE_ngrokc=y
# 定时重启：只依赖 luci-compat，体积极小
CONFIG_PACKAGE_luci-app-autoreboot=y

# ===== 代理插件：helloworld 的 luci-app-ssr-plus（pin 到 a201839 / xray v1.8.24）=====
#   pin 由 diy-part1.sh 的 SMALL_FLASH_PATTERNS 触发（本机型已在名单里），
#   xray 精简补丁集由 patch-xray-slim.py 按 PKG_VERSION 自动选 1.8.24 那套（5 个补丁）。
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_Iptables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_V2ray=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan_Plus=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Kcptun=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_MosDNS=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_DNS2SOCKS=n
# ❗ choice：Client 只能选一个。保留 libev（ss-local + ss-redir），不写 NONE_Client。
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Client=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_NONE_Server=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Server=n
# SSR / Rust / obfs 关闭
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Simple_Obfs=n
# ChinaDNS-NG 保留（分流用）
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ChinaDNS_NG=y
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_xray-core=y

# 18.06 系补丁：iptables-mod-socket 兼容元包（diy-part2.sh 第 16 段注入空元包补名）
CONFIG_PACKAGE_iptables-mod-socket=y

# ===== TLS 后端：保持本分支默认的 openssl（**不要学 wr1200js 换 mbedtls**）=====
#   核实依据：include/target.mk 的 DEFAULT_PACKAGES 里写的是 libustream-openssl，
#   且 luci-app-ssr-plus 187-2 的 DEPENDS 指向 libustream-openssl20201210（虚拟名），
#   ngrokc 也硬依赖 libopenssl1.1 —— 换 mbedtls 会同时得罪这两条依赖链。
#   libustream-openssl 与 libustream-mbedtls 装的是同一个 /lib/libustream-ssl.so，
#   两者同选必在打包期 check_data_file_clashes。
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_libustream-mbedtls=n
CONFIG_PACKAGE_libmbedtls=n
CONFIG_PACKAGE_libustream-wolfssl=n
CONFIG_PACKAGE_libwolfssl=n

# ===== 无线：ath10k-ct（5G QCA9882）+ ath9k（2.4G 内置）=====
#   ❗ 5G 驱动：**smallbuffers 变体**（按用户要求"有 smallbuffer 就用"）。
#      它是 package/kernel/ath10k-ct 的第二个 VARIANT（同一份源码，编译期加
#      -DCONFIG_ATH10K_SMALLBUFFERS），减小 TX/RX ring 的内存占用。
#      两个变体 PROVIDES 都是 kmod-ath10k，**只能选一个**（同选 = 装同一批 .ko，打包期冲突）。
#      代价：峰值吞吐略降（聚合深度受限）。本机 128MB 内存其实不需要它，
#      若实测 5G 速度不理想，把下面两行对调回 regular 即可（一行改动）：
#          CONFIG_PACKAGE_kmod-ath10k-ct=y
#          CONFIG_PACKAGE_kmod-ath10k-ct-smallbuffers=n
#   ❗ 主线的 kmod-ath10k（mac80211 包内）必须 =n，否则与 -ct 抢同一张 PCIe 卡。
CONFIG_PACKAGE_kmod-ath10k-ct-smallbuffers=y
CONFIG_PACKAGE_kmod-ath10k-ct=n
CONFIG_PACKAGE_kmod-ath10k=n
#   5G 固件：9880/9882 共用 qca988x-ct（不是 xd4200 的 qca9888-ct！）
CONFIG_PACKAGE_ath10k-firmware-qca988x-ct=y
CONFIG_PACKAGE_ath10k-firmware-qca988x-ct-full-htt=n
CONFIG_PACKAGE_ath10k-firmware-qca9888-ct=n
CONFIG_PACKAGE_kmod-ath9k=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-cfg80211=y
#   wpad：ath79 generic 默认 wpad-basic-openssl，保留（11ac 由 hostapd 的
#   CONFIG_IEEE80211AC 决定，与 SSL 后端无关）。不要另选 wpad-basic（无 -openssl 后缀版
#   在本分支可能与 wolfssl 依赖打架），也不要选 wpad-openssl（与默认项同 PROVIDES）。
CONFIG_PACKAGE_wpad-basic-openssl=y
CONFIG_PACKAGE_wpad-openssl=n
CONFIG_PACKAGE_wpad=n
CONFIG_PACKAGE_wpad-mini=n
CONFIG_PACKAGE_wpad-basic=n
CONFIG_PACKAGE_wpad-basic-wolfssl=n
CONFIG_PACKAGE_wpad-wolfssl=n
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_hostapd-common=y
CONFIG_PACKAGE_libiwinfo=y
CONFIG_PACKAGE_libiwinfo-lua=y
CONFIG_PACKAGE_libiwinfo-data=y
CONFIG_PACKAGE_iwinfo=y

# ===== 有线 / 交换机 / 按键 / LED =====
#   QCA8337N 用 swconfig + 内核内建的 ar8327 驱动（DTS mdio0 里带 initvals），
#   swconfig 就在 ath79 的 DEFAULT_PACKAGES 里，这里显式保留。
CONFIG_PACKAGE_swconfig=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y
# uboot-envtools：本机刷 breed，没有可用的 U-Boot 环境区，DEVICE_PACKAGES 里已用
#   -uboot-envtools 排除（省 ~45KB）；这里同步 =n 防被 DEFAULT_PACKAGES 拉回。
CONFIG_PACKAGE_uboot-envtools=n
# PPPoE：当主路由拨号必需；只当 AP/旁路由时改 =n 可再省约 35KB
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y
# IPv6：不开（省 odhcp6c/odhcpd ≈30KB，且避免 odhcpd 变体撞包）
CONFIG_PACKAGE_odhcp6c=n
CONFIG_PACKAGE_odhcpd=n
CONFIG_PACKAGE_odhcpd-ipv6only=n
CONFIG_PACKAGE_dnsmasq-full=y

# ===== 管理：保留 dropbear + opkg（本机没要求砍）=====
#   与 wr1200js 不同：那台按用户要求摘了 SSH 与包管理；这台保留，
#   代价约 100KB squashfs，换来 SSH 管理 + 运行期补装小包的能力。
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_opkg=y

# ===== USB：本机没有 USB 口，整条链关死 =====
CONFIG_PACKAGE_kmod-usb-core=n
CONFIG_PACKAGE_kmod-usb2=n
CONFIG_PACKAGE_kmod-usb3=n
CONFIG_PACKAGE_kmod-usb-ehci=n
CONFIG_PACKAGE_kmod-usb-ohci=n
CONFIG_PACKAGE_kmod-usb-storage=n
CONFIG_PACKAGE_kmod-usb-storage-extras=n
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=n
CONFIG_PACKAGE_kmod-usb-hid=n
CONFIG_PACKAGE_usbutils=n
CONFIG_PACKAGE_block-mount=n
CONFIG_PACKAGE_kmod-fs-ext4=n
CONFIG_PACKAGE_kmod-fs-vfat=n
CONFIG_PACKAGE_kmod-scsi-core=n

# ===== 其它常见拖体积项：显式关掉 =====
CONFIG_PACKAGE_luci-app-diskman=n
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-rclone=n
CONFIG_PACKAGE_luci-app-turboacc=n
CONFIG_PACKAGE_luci-app-filetransfer=n
CONFIG_PACKAGE_luci-lib-fs=n
CONFIG_PACKAGE_luci-app-cpufreq=n
CONFIG_PACKAGE_ubi-utils=n
# conntrack ALG 助手（FTP/SIP/IRC/H.323，≈53KB）：家用不需要
CONFIG_PACKAGE_kmod-nf-nathelper-extra=n
CONFIG_PACKAGE_kmod-mppe=n
# ip-full -> ip-tiny：tproxy 只用 ip rule / ip route，顺带甩掉 libbpf0 + libelf1
#   ❗ 必须同时在 diy-part2.sh 第 [20] 段把 ssr-plus 的 +ip-full 改成 +ip-tiny
CONFIG_PACKAGE_ip-tiny=y
CONFIG_PACKAGE_ip-full=n

# ===== zram 应急缓冲（128MB 内存机型）=====
#   配合 diy-part2.sh [16b] 注入的 /etc/init.d/zramswap（32MB 盘，disksize 不预占内存，
#   用到才吃）+ GOGC=75 / GOMEMLIMIT=32MiB。xray 峰值 RSS ~15MB 时可兜住 OOM。
#   ❗ 只用 kmod-zram，不选 zram-swap 包 —— 那个会再装一份 init 脚本，与 [16b] 的重复。
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=n
