# EZVIZ CS-W3-WD1200G EUP（萤石 W3）—— openwrt-18.06-k5.4 分支 · **原厂 16MB SPI-NOR**
#   IPQ4018（4× Cortex-A7 @716MHz）/ 128MB DDR3 / 16MB SPI NOR /
#   IPQ4018 内置双频 2.4G+5G（ath10k-ct）/ QCA8075 交换（1WAN+3LAN）/ **无 USB**
#
# 目标与 K2P 那份一致：无线可用 + ssr-plus(xray) + vless/reality，体积卡进 16MB。
# 但空间比 K2P 更紧：
#   K2P     firmware 分区 16064k —— 实测镜像 15360k，overlay 703k（已告警不足 1MiB）
#   萤石 W3  firmware 分区 14848k —— **比 K2P 少 1216k**
# 光靠「照搬 K2P 的裁剪」必然溢出。本机型额外靠两件事补回来：
#   ① xray 保持 v1.8.4（不做 K2P 那样的 1.8.24 前移）              ≈ -800k
#      理由：1.8.4 的 reality 链路已逐文件核实完整（client-config.lua /
#      ssrurl.htm / subscribe.lua / gen_config.lua 四处均有 realitySettings）。
#   ② xray 二进制精简（scripts/patch-xray-slim.py，剔除 quic/grpc/kcp/
#      wireguard 等 12 个可选模块的空导入）                        ≈ -1500~-2000k
#      vless + reality + tls + tcp + websocket 全保留，SS/SSR 走独立的
#      shadowsocks-libev 二进制，不受影响。
#
# ⚠️ 与同名的 23.05 机型区分（别拿错）：
#   config/ezviz_cs-w3-wd1200g-32m.config   23.05 分支，已换 32MB 芯片，
#       diy-part2.sh 第[16]段会把 DTS firmware 扩到 0x1E80000 / IMAGE_SIZE 31232k。
#   本文件（config-18.06/，无 -32m 后缀）  18.06-k5.4 分支，**原厂 16MB**，
#       第[16]段按 TARGET_CONFIG 精确匹配 `*-32m.config`，不会碰这台的分区。
#       如果分区被误扩容到 30.5MiB，16MiB 芯片写入越界 = 直接砖。
#
# ⚠️ TLS 后端（18.06-k5.4 的坑，同 K2P）：libustream-mbedtls 是默认后端，
#   libustream-openssl 必须 =n，两者都提供 lib/libustream-ssl.so，
#   同选会在 opkg 安装期 check_data_file_clashes 失败。
#
# ⚠️ 设备符号（铁律：CONFIG_TARGET_<target>_<subtarget>_DEVICE_<device>=y）
CONFIG_TARGET_ipq40xx=y
CONFIG_TARGET_ipq40xx_generic=y
CONFIG_TARGET_ipq40xx_generic_DEVICE_ezviz_cs-w3-wd1200g-eup=y

# ===== 镜像 =====
CONFIG_TARGET_OPTIMIZE_FOR_SIZE=y
CONFIG_TARGET_SQUASHFS_XZ=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# squashfs 块大小 256(默认) -> 1024 KiB。唯一「一个包都不砍、纯压缩效率变现」的项：
#   块越大 xz 字典越大、重复串命中窗口越宽，同样内容镜像普遍小 3~8%。
#   代价：运行时解压单元 256k->1M，多占约 1MiB 内存（128MB 可忽略）。
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=1024
# ❗ initramfs 必须 =y（与 K2P 相反）：这台没有 Breed / 没有 Web 刷机入口，
#   首次刷机只能串口（J8，115200 8N1）TFTP 引导 initramfs 起内存系统，
#   再 sysupgrade 落地。它只占编译产物、不占 flash。
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_CCACHE=y

# ===== 内核裁剪（K2P 那轮没开，本机型空间更紧，加上）=====
# STRIP_KERNEL_EXPORTS 去掉内核未使用的导出符号表（__ksymtab/__kcrctab），
#   必须配 USE_MKLIBS=y，否则内核模块会因为找不到导出符号而加载失败 —— 两者成对。
# KALLSYMS=n 再去掉符号名表，省得更多；代价是 oops 里函数名全是地址。
CONFIG_STRIP_KERNEL_EXPORTS=y
CONFIG_USE_MKLIBS=y
CONFIG_KERNEL_KALLSYMS=n

# ===== LuCI（最小集）=====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=n
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_luci-app-frpc=n
CONFIG_PACKAGE_luci-app-ttyd=n
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-ssl-openssl=n

# ===== ngrokc 内网穿透（真实成本含 libstdcpp ≈300k squashfs）=====
CONFIG_PACKAGE_luci-app-ngrokc=y
CONFIG_PACKAGE_ngrokc=y

# ===== 管理基础 =====
CONFIG_PACKAGE_dropbear=y
# opkg：include/target.mk 的 DEFAULT_PACKAGES 硬编码项。
#   diy-part2 [22] 段会从 target.mk 摘除（.config 单独写 =n 无效，defconfig 会翻回 =y）。
#   这里写 =n 是第二道保险：若被任何 select 拉回，CI 的 kconfig 反向校验会直接失败。
#   收益约 75 KiB；代价是 LuCI「软件包」页面失效（overlay 只有百来 KiB，本就装不了包）。
CONFIG_PACKAGE_opkg=n
# ssr-plus 硬依赖 ipset，dnsmasq-full 不可降级
CONFIG_PACKAGE_dnsmasq-full=y

# ===== TLS 后端（单一 mbedtls）=====
CONFIG_PACKAGE_libustream-openssl=n
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_libmbedtls=y

# ===== ssr-plus（helloworld pin 到 a201839 = 187-2 + xray 1.8.4）=====
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_Iptables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_V2ray=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Kcptun=n
# choice：客户端只能选一个。保留 libev（ss 协议可能要用），NONE 置 n。
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Client=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_NONE_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_NONE_Server=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Simple_Obfs=n
# ChinaDNS-NG 保留（IP 分流用）
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ChinaDNS_NG=y
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_xray-core=y

# 18.06 系补丁：iptables-mod-socket 兼容元包（diy-part2.sh 注入空元包补名）
CONFIG_PACKAGE_iptables-mod-socket=y

# ===== 无线：ath10k-ct（IPQ4018 内置双频，走 SoC 直出）=====
# 上游 generic.mk 的 DEVICE_PACKAGES 已写死：
#   -kmod-ath10k-ct kmod-ath10k-ct-smallbuffers
# 即 smallbuffers 变体是默认行为，这里显式固化一次，防止 defconfig 翻回 regular。
CONFIG_PACKAGE_kmod-ath10k-ct-smallbuffers=y
CONFIG_PACKAGE_kmod-ath10k-ct=n
CONFIG_PACKAGE_ath10k-firmware-qca4019-ct=y
CONFIG_PACKAGE_ath10k-board-qca4019=y
CONFIG_PACKAGE_ipq-wifi-ezviz_cs-w3-wd1200g-eup=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-cfg80211=y
# wpad：只要 WPA2-PSK，basic 比 openssl 省约 100KB
CONFIG_PACKAGE_wpad-basic=y
CONFIG_PACKAGE_wpad-openssl=n
CONFIG_PACKAGE_wpad-wolfssl=n
CONFIG_PACKAGE_wpad=n
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_hostapd-common=y

# ===== 有线/按键/LED =====
CONFIG_PACKAGE_swconfig=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_autocore-arm=y

# ===== 拨号 / IPv6 =====
# PPPoE：当主路由拨号要保留（≈35k）。纯 AP / 旁路由可改 =n。
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y
# IPv6：本机不开（省 odhcp6c/odhcpd ≈ 30k）
CONFIG_PACKAGE_odhcp6c=n
CONFIG_PACKAGE_odhcpd=n

# ===== USB：整条链全灭（本机只有一个 DC 口，无任何 USB 接口）=====
# ipq40xx 的 DEFAULT_PACKAGES 硬塞了 kmod-usb3 / kmod-usb-dwc3 /
# kmod-usb-dwc3-qcom / e2fsprogs，纯属白给。单个 =n 删不掉它们（target 级
# DEFAULT_PACKAGES 优先于 .config），由第[21]段 patch-ipq40xx-slim.py 从
# target Makefile 里摘除；下面这些 =n 是让依赖图保持一致、避免 defconfig 回拉。
CONFIG_PACKAGE_kmod-usb-core=n
CONFIG_PACKAGE_kmod-usb2=n
CONFIG_PACKAGE_kmod-usb3=n
CONFIG_PACKAGE_kmod-usb-dwc3=n
CONFIG_PACKAGE_kmod-usb-dwc3-qcom=n
CONFIG_PACKAGE_kmod-usb-ehci=n
CONFIG_PACKAGE_kmod-usb-ohci=n
CONFIG_PACKAGE_kmod-usb-dwc2=n
CONFIG_PACKAGE_kmod-usb-storage=n
CONFIG_PACKAGE_kmod-usb-storage-extras=n
CONFIG_PACKAGE_kmod-usb-storage-uas=n
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=n
CONFIG_PACKAGE_kmod-usb-hid=n
CONFIG_PACKAGE_kmod-usb-net=n
CONFIG_PACKAGE_kmod-usb-serial=n
CONFIG_PACKAGE_usbutils=n
CONFIG_PACKAGE_usb-modeswitch=n
CONFIG_PACKAGE_libusb-1.0=n
CONFIG_PACKAGE_block-mount=n
CONFIG_PACKAGE_kmod-scsi-core=n
CONFIG_PACKAGE_kmod-fs-ext4=n
CONFIG_PACKAGE_kmod-fs-vfat=n
CONFIG_PACKAGE_kmod-fs-ntfs=n
CONFIG_PACKAGE_kmod-fs-f2fs=n
CONFIG_PACKAGE_e2fsprogs=n
CONFIG_PACKAGE_fdisk=n
CONFIG_PACKAGE_lsblk=n
CONFIG_PACKAGE_luci-app-hd-idle=n

# ===== 其它拖体积项：显式关掉 =====
CONFIG_PACKAGE_libustream-wolfssl=n
CONFIG_PACKAGE_libwolfssl=n
CONFIG_PACKAGE_luci-app-diskman=n
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-rclone=n
CONFIG_PACKAGE_luci-app-turboacc=n
CONFIG_PACKAGE_luci-app-filetransfer=n
CONFIG_PACKAGE_luci-lib-fs=n
CONFIG_PACKAGE_luci-app-cpufreq=n
# ubi-utils：ipq40xx 的 target Makefile 带 FEATURES nand，会把它塞进 DEFAULT_PACKAGES。
#   本机是 SPI NOR、没有 UBI 卷。diy-part2 第[21]段（scripts/patch-ipq40xx-slim.py）
#   会把 FEATURES 的 nand 摘掉，这里再显式 =n 双保险。
CONFIG_PACKAGE_ubi-utils=n
# conntrack ALG（FTP/SIP/IRC 等），家用不需要
CONFIG_PACKAGE_kmod-nf-nathelper-extra=n
# MPPE 是 PPTP 加密，PPPoE 用不到
CONFIG_PACKAGE_kmod-mppe=n
# ip-full -> ip-tiny：tproxy 只用 ip rule/ip route，顺带甩掉 libbpf0 + libelf1（≈330k）
#   第[20]段已把 ezviz 纳入门控，会在 defconfig 之前把 ssr-plus 的 +ip-full
#   改成 +ip-tiny，两者一致，不会触发硬依赖把 ip-full 拉回来。
CONFIG_PACKAGE_ip-tiny=y
CONFIG_PACKAGE_ip-full=n

# ===== 依赖自洽兜底：kmod-mii（不改体积，防打包炸）=====
CONFIG_PACKAGE_kmod-mii=y
