# DomyWifi DW33D（ath79/nand，QCA9558）—— openwrt-18.06-k5.4 分支 · 纯 16MB SPI NOR 精简版
#
# 分支隔离说明：
#   - 本文件放在独立的 config-18.06/ 目录，与 23.05 的 config/ 互不污染；
#     build.yml 的 prepare 会按所选 source_branch 自动选 config 或 config-18.06。
#   - openwrt-18.06-k5.4 是「18.06 包基础 + 5.4 新内核」，兼容 helloworld / ngrokc / frpc；
#     本 config 走「小闪存精简」路线：ssr-plus 只开 ss+vless、去 ssh/opkg/ssl、不编 frpc，但保留 ngrokc。
#     只有真正老内核的 openwrt-18.06（4.x）才会跳过 helloworld。
#   - 默认管理地址 192.168.6.1 由 scripts/diy-part2.sh 统一设置（sed 替换 192.168.1.1）。
#
# ⚠️ SPI NOR 专用设备符号：18.06-k5.4 的 nand.mk 已自带官方的「domywifi_dw33d-nor」变体
#    （SPI NOR 启动，IMAGE_SIZE=14464k=14MB，适配 16MB SPI），直接选它即可，无需注入镜像目标。
#    设备符号（铁律：CONFIG_TARGET_<target>_<subtarget>_DEVICE_<device>=y，subtarget 仍是 ath79/nand）：
CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_nand=y
CONFIG_TARGET_ath79_nand_DEVICE_domywifi_dw33d-nor=y

# ===== 体积优化（16MB SPI NOR 关键）=====
CONFIG_TARGET_OPTIMIZE_FOR_SIZE=y        # 全局 -Os 编译，省空间
CONFIG_TARGET_SQUASHFS_XZ=y              # 镜像 xz 压缩，比默认 gzip 小一截

# ===== LuCI Web 管理（仅 http，去 ssl 省 openssl/libustream ~1MB）=====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
# 不用 https：不编 luci-ssl / libustream

# ===== 用户明确不要的功能 =====
CONFIG_PACKAGE_dropbear=n                 # SSH 服务端
CONFIG_PACKAGE_opkg=n                     # 包管理器 CLI
CONFIG_PACKAGE_luci-app-opkg=n            # opkg 的 LuCI 前端

# ===== 剔除源码默认会编进来的「附加包」=====
# 基础默认包 DEFAULT_PACKAGES（无 opkg/https 后整条 TLS 链没用）
CONFIG_PACKAGE_uclient-fetch=n
CONFIG_PACKAGE_libustream-openssl=n
CONFIG_PACKAGE_libustream-mbedtls=n       # 18.06-k5.4 默认集选的是 mbedtls 后端，只关 openssl 会悬空 → 一并关
CONFIG_PACKAGE_ca-bundle=n
CONFIG_PACKAGE_logd=n
# immortalwrt tweak 全家桶（DEFAULT_PACKAGES.tweak）
CONFIG_PACKAGE_luci-lib-ipkg=n
CONFIG_PACKAGE_luci-lib-fs=n
CONFIG_PACKAGE_luci-app-cpufreq=n
CONFIG_PACKAGE_luci-app-filetransfer=n
# USB 全部去除（用户不需要 USB，纯 SPI 精简版）
#   注：diy-part2.sh 注入脚本会从 nand.mk 的 domywifi_dw33d 父定义里剔除
#   kmod-usb2/kmod-usb-storage/kmod-usb-ledtrig-usbport，dw33d-nor 继承后亦无 USB。
CONFIG_PACKAGE_block-mount=n              # USB 存储挂载（无 USB 则不需要）
CONFIG_PACKAGE_kmod-usb2=n
CONFIG_PACKAGE_kmod-usb-storage=n
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=n
CONFIG_PACKAGE_kmod-usb-ohci=n
CONFIG_PACKAGE_kmod-usb-ehci=n
CONFIG_PACKAGE_kmod-usb-core=n
CONFIG_PACKAGE_kmod-nf-nathelper-extra=n  # TFTP/SIP ALG，家用不需要
# 路由器默认包：dnsmasq 不可降级（ssr-plus 硬依赖 full 的 ipset）
CONFIG_PACKAGE_dnsmasq-full=y

# ===== IPv6：整条去掉（省 ~1MB+）=====
CONFIG_IPV6=n
# 去掉 IPv6 会自动剔除 odhcpd/odhcp6c/6in4/6rd/ds-lite/map/kmod-ip6tables/luci-proto-ipv6

# ===== 用户指定插件 =====
# -- luci-app-ssr-plus（diy-part1.sh 注入 helloworld 源）--
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Client=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_MosDNS=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_V2ray=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y      # VLESS 由 xray-core 提供
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Kcptun=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NaiveProxy=n
# -- luci-app-ngrokc（内网穿透 GUI，用户需要保留）--
CONFIG_PACKAGE_luci-app-ngrokc=y
# -- luci-app-frpc：小闪存精简版不编（如需可改 =y）--
# CONFIG_PACKAGE_luci-app-frpc is not set

# ===== 无线驱动（ath79：2.4G ath9k + 5G ath10k-ct）=====
CONFIG_PACKAGE_kmod-ath9k=y
CONFIG_PACKAGE_kmod-ath10k-ct=y
CONFIG_PACKAGE_ath10k-firmware-qca988x-ct=y

# ===== 基础网络增强（按需）=====
CONFIG_PACKAGE_luci-app-upnp=y            # UPnP 端口映射（家用常用，体积不大）
CONFIG_PACKAGE_luci-app-ttyd=n             # 不编网页终端
CONFIG_PACKAGE_wget=n
CONFIG_PACKAGE_curl=n

# ===== TurboACC：保留（千兆线速 NAT offload，去则 ath79 软转发掉速）=====
# luci-app-turboacc 走默认（DEFAULT_PACKAGES.tweak 自带）

# CCACHE（workflow 也会再追加一次，这里写上也无害）
CONFIG_CCACHE=y
