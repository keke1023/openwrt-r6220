# ipTIME A3004NS-dual = 国内 TOTOLINK A3004NS（同款硬件）—— openwrt-18.06-k5.4 分支
#   MT7621A / 256MB DDR3 / **16MB SPI NOR** / MT7602E(2.4G) + MT7612E(5G) / 4LAN+1WAN / USB3.0
#
# 本配置的目标：**纯有线、无 USB** 小体积固件 + ssr-plus(xray) + vless/reality
#   - 全部无线驱动关闭（kmod-mt76x2 / mac80211 / cfg80211 / wpad / iwinfo / wireless-regdb）
#   - **整条 USB 链关闭**（kmod-usb* / usbutils / libusb* / block-mount / kmod-fs-* / scsi）
#   - ssr-plus 只编 Xray 一个核心，SS/SSR/Trojan/V2Ray/Kcptun/Naive 全部 =n
#
# ⚠️ 体积账（16MB 芯片，firmware 分区 IMAGE_SIZE=16128k≈15.75MiB）：
#   基础系统(无wifi/无usb) 4.4 + luci 2.3 + ssr-plus 0.3 + xray v1.8.4(~4.8) ≈ 11.8MiB
#   余 ~3.9MiB 给 overlay —— 勉强够用。
#   若改用 helloworld master 最新 xray(v26.x)，xray 单项就要 ~7.5MiB，总计 ≈14.6MiB，
#   overlay 只剩 1MiB，日志一多就写满 → 故 diy-part1.sh 对本机型强制 pin 到 xray v1.8.4。
#
# ⚠️ TLS 后端（18.06-k5.4 的坑，沿用 dw33d/k2p 已验证写法）：
#   本分支 DEFAULT_PACKAGES 把 libustream-mbedtls 作默认后端。libustream-openssl 必须 =n，
#   两者都提供 lib/libustream-ssl.so，同选会在 opkg 安装期 check_data_file_clashes 失败。
#
# ⚠️ 设备符号（铁律：CONFIG_TARGET_<target>_<subtarget>_DEVICE_<device>=y，subtarget 不可省）
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_iptime_a3004ns-dual=y

# ===== 镜像 =====
CONFIG_TARGET_OPTIMIZE_FOR_SIZE=y
CONFIG_TARGET_SQUASHFS_XZ=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# initramfs 必须保留：A3004NS-dual 从原厂/PandoraBox Web 界面首次刷入要用它
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_CCACHE=y

# ===== LuCI（最小集：基础 + 防火墙 + 软件包管理，不装 upnp/frpc/ngrokc/ttyd）=====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_luci-app-frpc=n
CONFIG_PACKAGE_luci-app-ngrokc=n
CONFIG_PACKAGE_luci-app-ttyd=n

# ===== 管理基础 =====
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_opkg=y
# ssr-plus 硬依赖 ipset，dnsmasq-full 不可降级为 dnsmasq
CONFIG_PACKAGE_dnsmasq-full=y

# ===== TLS 后端（单一 mbedtls；openssl 版本必须关掉避免双后端冲突）=====
CONFIG_PACKAGE_libustream-openssl=n
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_libmbedtls=y

# ===== 代理插件：helloworld master 的 luci-app-ssr-plus =====
# 注意：具体 commit 由 scripts/diy-part1.sh 按机型 pin（本机型 → a201839 / xray v1.8.4）
CONFIG_PACKAGE_luci-app-ssr-plus=y
# 18.06 系无 firewall4，透明代理走 iptables（choice 默认即 iptables，此处显式固化）
CONFIG_PACKAGE_luci-app-ssr-plus_Iptables_Transparent_Proxy=y
# —— 只保留 Xray（vless/reality 由它提供），其余核心全部关闭 ——
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_V2ray=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan_Plus=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Kcptun=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_MosDNS=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_DNS2SOCKS=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Simple_Obfs=n
# ChinaDNS-NG 保留（分流用，ssr-plus 的硬依赖链，~300KB）
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ChinaDNS_NG=y
CONFIG_PACKAGE_chinadns-ng=y
# 显式打上 xray-core（避免仅靠 select 继承时漏编）
CONFIG_PACKAGE_xray-core=y

# ===== 18.06 系补丁：iptables-mod-socket 兼容元包 =====
#   ssr-plus 启动自检需要该包名，18.06 系不存在 → 由 diy-part2.sh 第16段注入空元包补名
CONFIG_PACKAGE_iptables-mod-socket=y

# ===== 无线：全关（本机做纯有线路由/旁路由）=====
CONFIG_PACKAGE_kmod-mt76x2=n
CONFIG_PACKAGE_kmod-mt76-core=n
CONFIG_PACKAGE_kmod-mac80211=n
CONFIG_PACKAGE_kmod-cfg80211=n
CONFIG_PACKAGE_kmod-mt7602e=n
CONFIG_PACKAGE_kmod-mt7612e=n
CONFIG_PACKAGE_wpad-basic=n
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_wpad-openssl=n
CONFIG_PACKAGE_iwinfo=n
CONFIG_PACKAGE_wireless-regdb=n
CONFIG_PACKAGE_kmod-mt76=n

# ===== USB：整条链全灭（本机纯有线，明确不使用 U 盘/移动硬盘）=====
#   ⚠️ 关掉 kmod-usb-core 后内核 CONFIG_USB 不再被置位 ——
#      mt7621 的 target/linux/ramips/mt7621/config-5.4 里只有 CONFIG_USB_SUPPORT=y
#      （纯菜单总开关，不编任何代码），CONFIG_USB 本体由 kmod-usb-core 的 KCONFIG 引入。
#      所以 USB 子系统整体不进固件；DTS 里的 xhci/ehci 节点与 usb LED 仍在但无驱动绑定，
#      属无害残留（不影响启动，仅 usb LED 不会有 usbport 触发器）。
#   ⚠️ 副作用（务必知晓）：没有 USB ⇒ **失去 extroot 退路**，overlay 只能落在
#      rootfs_data（约 3.9MiB）。日后想装大包（geoip.dat、docker 等）只能重编固件或换机型。
CONFIG_PACKAGE_kmod-usb-core=n
CONFIG_PACKAGE_kmod-usb2=n
CONFIG_PACKAGE_kmod-usb3=n
CONFIG_PACKAGE_kmod-usb-ehci=n
CONFIG_PACKAGE_kmod-usb-ohci=n
CONFIG_PACKAGE_kmod-usb-uhci=n
CONFIG_PACKAGE_kmod-usb-dwc2=n
CONFIG_PACKAGE_kmod-usb-storage=n
CONFIG_PACKAGE_kmod-usb-storage-extras=n
CONFIG_PACKAGE_kmod-usb-storage-uas=n
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=n
CONFIG_PACKAGE_kmod-usb-hid=n
CONFIG_PACKAGE_kmod-usb-net=n
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=n
CONFIG_PACKAGE_kmod-usb-net-rtl8152=n
CONFIG_PACKAGE_kmod-usb-serial=n
CONFIG_PACKAGE_kmod-usb-serial-ftdi=n
CONFIG_PACKAGE_kmod-usb-printer=n
CONFIG_PACKAGE_usbutils=n
CONFIG_PACKAGE_usb-modeswitch=n
CONFIG_PACKAGE_libusb-1.0=n
CONFIG_PACKAGE_libusb-compat=n
# 存储/文件系统（原本只为 extroot 服务，USB 关掉后一并剔除；block-mount 还是
# DEFAULT_PACKAGES.tweak 的默认 y，必须在 diy-strip.sh 里硬压）
CONFIG_PACKAGE_block-mount=n
CONFIG_PACKAGE_kmod-scsi-core=n
CONFIG_PACKAGE_kmod-fs-ext4=n
CONFIG_PACKAGE_kmod-fs-vfat=n
CONFIG_PACKAGE_kmod-fs-ntfs=n
CONFIG_PACKAGE_kmod-fs-exfat=n
CONFIG_PACKAGE_kmod-fs-f2fs=n
CONFIG_PACKAGE_e2fsprogs=n
CONFIG_PACKAGE_fdisk=n
CONFIG_PACKAGE_lsblk=n
CONFIG_PACKAGE_luci-app-hd-idle=n

# ===== 其它常见拖体积项：显式关掉 =====
CONFIG_PACKAGE_libustream-wolfssl=n
CONFIG_PACKAGE_libwolfssl=n
CONFIG_PACKAGE_ppp=n
CONFIG_PACKAGE_ppp-mod-pppoe=n
CONFIG_PACKAGE_odhcp6c=n
CONFIG_PACKAGE_odhcpd=n
CONFIG_PACKAGE_luci-app-diskman=n
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-rclone=n
CONFIG_PACKAGE_luci-app-turboacc=n
