# ============================================================
# ipTIME A3004NS-Dual（ramips/mt7621）—— openwrt-18.06-k5.4 纯 16MB SPI NOR 精简版
#   用户要求：去除无线驱动 + 去除 USB，纯有线路由 + 代理。
#   设备符号铁律：subtarget 段不能省，必须是
#     CONFIG_TARGET_ramips_mt7621_DEVICE_iptime_a3004ns-dual=y
#   闪存：SPI NOR 16MB（firmware 分区 16128k），无需注入镜像目标。
#   源码默认 DEVICE_PACKAGES := kmod-usb3 kmod-mt76x2 kmod-usb-ledtrig-usbport
#     —— 经 diy-part2.sh 第8段从源头剔除（.config 删不掉）。
#   触发：targets=a3004ns-dual + source_branch=openwrt-18.06-k5.4
# ============================================================

# —— 目标平台（父 target + subtarget 两行必须齐全，否则 defconfig 静默回退 x86）——
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_iptime_a3004ns-dual=y

# —— 编译/镜像级瘦身 ——
CONFIG_TARGET_OPTIMIZE_FOR_SIZE=y          # 全局 -Os，显著减小体积
CONFIG_TARGET_SQUASHFS_XZ=y                # squashfs 用 XZ 压缩（比默认 gzip 更小）

# —— LuCI 与 Web 管理（走纯 http，去掉 openssl/libustream 省 ~1MB）——
CONFIG_PACKAGE_luci=y
# CONFIG_PACKAGE_luci-ssl-openssl is not set
# 18.06-k5.4 DEFAULT_PACKAGES 软集选 mbedtls 后端，=n 压不住；改 =y 并补 libmbedtls 本体防 ustream-ssl-mbedtls cmake 悬空
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_libmbedtls=y

# —— 不要 SSH / opkg（用户明确不要）——
CONFIG_PACKAGE_dropbear=n
CONFIG_PACKAGE_opkg=n
CONFIG_PACKAGE_luci-app-opkg=n            # opkg 的 LuCI 前端

# —— 用户指定代理插件（与 18.06 其他精简机型一致）——
# -- luci-app-ssr-plus（helloworld master，18.06-k5.4 放行）：仅 ss + vless --
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Client=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_V2ray=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Kcptun=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_MosDNS=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NaiveProxy=n

# -- luci-app-ngrokc（用户需要）--
CONFIG_PACKAGE_luci-app-ngrokc=y
# -- 不编 frpc --
# CONFIG_PACKAGE_luci-app-frpc is not set

# —— 源码默认附加包（DEFAULT_PACKAGES.tweak / 基础 TLS 链）剔除 ——
CONFIG_PACKAGE_uclient-fetch=n            # 整条 TLS 链，无 opkg 后用不到
CONFIG_PACKAGE_libustream-openssl=n
CONFIG_PACKAGE_ca-bundle=n
CONFIG_PACKAGE_logd=n
CONFIG_PACKAGE_luci-lib-ipkg=n
CONFIG_PACKAGE_luci-lib-fs=n
CONFIG_PACKAGE_luci-app-cpufreq=n
CONFIG_PACKAGE_luci-app-filetransfer=n
CONFIG_PACKAGE_block-mount=n              # 无 USB / 无存储，去掉
CONFIG_PACKAGE_kmod-nf-nathelper-extra=n  # TFTP/SIP ALG，家用不需要

# —— 保留 dnsmasq-full（ssr-plus 的 ipset 硬依赖，GFWlist 分流用，不可降级）——
CONFIG_PACKAGE_dnsmasq-full=y

# —— 去掉 IPv6 协议栈（CONFIG_IPV6=n，省 ~1MB+，自动连带剔除 odhcpd/odhcp6c 等）——
CONFIG_IPV6=n

# —— 无线驱动：用户要求去除，diy-part2.sh 第8段已从源码 DEVICE_PACKAGES 剔除 kmod-mt76x2 ——
# CONFIG_PACKAGE_kmod-mt76x2 is not set
# CONFIG_PACKAGE_kmod-mt76 is not set

# —— USB 驱动：用户不需要，diy-part2.sh 第8段已从源码 DEVICE_PACKAGES 剔除 ——
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-ledtrig-usbport is not set

# CCACHE（workflow 也会再追加一次，这里写上也无害）
CONFIG_CCACHE=y
