# YOUHUA WR1200JS（友华 WR1200JS，MT7621A）—— openwrt-18.06-k5.4 分支
#   MT7621A / 128MB DDR3 / **16MB SPI NOR** / MT7603E（2.4G）+ MT7612E（5G）双芯片 /
#   5×GE（1WAN+4LAN，MT7530 DSA）/ 1×USB3.0
#
# 本配置的目标：**无线可用 + ssr-plus(xray) + vless/reality + ngrokc**，体积卡进 16MB。
#   - 无线走**开源 mt76**：kmod-mt7603（2.4G）+ kmod-mt76x2（5G），上游 DEVICE_PACKAGES
#     本来就是这两个，无需像 K2P 那样换驱动；两颗芯片都在 PCIe 上，DTS 已写好 mt76 节点。
#   - 整条 USB 链关闭（16MB 没有 extroot 余量，且本配置不含 opkg，留着 USB 也无从补装
#     存储驱动，纯属占空间）。要留 U 盘能力见下方「USB」段的说明。
#   - ssr-plus 编 Xray 核心 + Shadowsocks(libev) 客户端；SSR / Rust / obfs 插件关闭
#   - 不要 dropbear、不要 opkg（用户明确要求）：本机只走 LuCI(uhttpd) 管理，
#     包管理能力放弃。已核实 LuCI 元包 LUCI_DEPENDS 不含这两者（见 build.yml 校验）。
#   - 硬件 offload 已启用（MT7621 PPE，fw3 下发 FLOWOFFLOAD --hw）
#
# ⚠️ 体积账（firmware 分区 IMAGE_SIZE=16064k，上游 DTS 已是
#     reg = <0x50000 0xfb0000>，无需像 K2P 那样前移起点）：
#   参考同类机型 K2P 实测 14848k / 上限 16064k / overlay 1215k，本机相对 K2P 的差异：
#     - 无线由 mt7615e+fw(687k 文件) 换成 mt7603+mt76x2+mt7662.bin(155k)   ≈ -190k
#     - 去掉 dropbear（~35k squashfs）+ opkg（~25k squashfs）              ≈  -60k
#     - USB 链与 K2P 同样全灭                                                ±   0
#   ------------------------------------------------------------------------------
#   ≈ 14600k → 留给 overlay ≈ 1450k（比 K2P 宽裕，越过 1MiB 线）
#
# ⚠️ 设备定义与网络：全部来自上游，本配置**不需要任何 DTS/mk/02_network 注入**
#     - DTS：target/linux/ramips/dts/mt7621_youhua_wr1200js.dts（上游自带）
#     - 设备：mt7621.mk 里 define Device/youhua_wr1200js（IMAGE_SIZE 16064k）
#     - 网络：MT7621 在本分支是 DSA（&switch0 { ports { label=wan/lan1..4 } }），
#             ramips/mt7621/base-files/etc/board.d/02_network 的 *) 兜底正好是
#             ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4" "wan"，无需分支
#     - MAC：DTS 用 nvmem-cells 直接绑 factory 0xe000/0xe006，board.d 不用管
#
# ⚠️ TLS 后端（18.06-k5.4 的坑）：libustream-mbedtls 为默认后端，libustream-openssl 必须 =n，
#   两者都提供 lib/libustream-ssl.so，同选会在 opkg 安装期 check_data_file_clashes 失败。
#
# ⚠️ 设备符号（铁律：CONFIG_TARGET_<target>_<subtarget>_DEVICE_<device>=y，subtarget 不可省）
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_youhua_wr1200js=y

# ===== 镜像 =====
CONFIG_TARGET_OPTIMIZE_FOR_SIZE=y
CONFIG_TARGET_SQUASHFS_XZ=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# squashfs 块大小 256(默认) -> 1024 KiB（零功能代价的最大一刀，详见 k2p.config 同类注释）
#   上游规则：default 1024 if (SMALL_FLASH && !LOW_MEMORY_FOOTPRINT)，否则 256。
#   显式写死，避免 SMALL_FLASH 顺带改 KERNEL_SQUASHFS_FRAGMENT_CACHE_SIZE。
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=1024
# 产物只要 squashfs-sysupgrade.bin（Breed/已有 OpenWrt 刷入）；initramfs 不必编。
# 若要从 Breed 的「固件更新」页直接刷，用 sysupgrade.bin 亦可；需要 recovery 时改 =y。
CONFIG_TARGET_ROOTFS_INITRAMFS=n
CONFIG_CCACHE=y

# ===== LuCI（最小集：基础 + 防火墙）=====
# 不要 luci-app-opkg —— 本机不装 opkg，装了也没东西可管，白占 ~40k
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=n
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_luci-app-frpc=n
# ngrokc：内网穿透（自带 ngrokc 1.55 + luci 前端）
#   ❗ 真实成本不止它自己：DEPENDS = libc libpthread libopenssl libstdcpp zlib，
#     其中 **libstdcpp（≈700K 安装 / ≈300K squashfs）** 才是大头。
CONFIG_PACKAGE_luci-app-ngrokc=y
CONFIG_PACKAGE_ngrokc=y
CONFIG_PACKAGE_luci-app-ttyd=n

# ===== 管理基础：不要 dropbear / opkg =====
#   dropbear 关闭的代价（已确认接受）：
#     ① 没有 SSH，只能走 LuCI(uhttpd) 管理；串口是唯一兜底
#     ② failsafe 模式下 99_10_failsafe_login 拉不起 telnet/ssh，只能串口登录
#     ③ 刷机方式不受影响（sysupgrade 与 dropbear 无关）
#   已核实：luci 元包的 LUCI_DEPENDS = uhttpd uhttpd-mod-ubus luci-mod-admin-full
#   luci-theme-bootstrap luci-app-firewall luci-proto-ppp libiwinfo-lua rpcd-mod-rrdns，
#   不含 dropbear / opkg；18.06 也没有 luci-app-dropbear 这个包。
CONFIG_PACKAGE_dropbear=n
#   opkg 关闭的代价：运行期无法再装包（含 kmod）；但**不影响镜像生成**
#   —— package/install 阶段用的是宿主机 opkg（staging_dir/host/bin/opkg），不是目标机包。
CONFIG_PACKAGE_opkg=n
# ssr-plus 硬依赖 ipset，dnsmasq-full 不可降级为 dnsmasq
CONFIG_PACKAGE_dnsmasq-full=y

# ===== TLS 后端（单一 mbedtls）=====
CONFIG_PACKAGE_libustream-openssl=n
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_libmbedtls=y

# ===== 代理插件：helloworld 的 luci-app-ssr-plus（pin 到 a201839 / xray v1.8.24）=====
#   pin 由 diy-part1.sh 的 SMALL_FLASH_PATTERNS 触发（本机型已在名单里）。
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_Iptables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_V2ray=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan_Plus=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Kcptun=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_MosDNS=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_DNS2SOCKS=n
# ❗ choice：Client 只能选一个。保留 libev（ss-local+ss-redir ≈90K squashfs），
#   不写 NONE_Client（与 k2p.config 的成功基线保持一致：写了 =n 也等效，
#   但 choice 成员多一行就多一个 out of sync 的机会，没必要）。
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Client=y
# 服务端用不到 → NONE
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_NONE_Server=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Server=n
# SSR / Rust / obfs 关闭（要 SSR 就把第一行改 y，+≈100KB）
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Simple_Obfs=n
# ChinaDNS-NG 保留（分流用）
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ChinaDNS_NG=y
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_xray-core=y

# 18.06 系补丁：iptables-mod-socket 兼容元包（diy-part2.sh 第16段注入空元包补名）
CONFIG_PACKAGE_iptables-mod-socket=y

# ===== 无线：开源 mt76（mt7603 + mt76x2）=====
#   MT7603E = 2.4G 11n，MT7612E = 5G 11ac 2×2，两颗都在 PCIe 上（DTS pcie0/pcie1，
#   eeprom 分别取 factory 0x0000 / 0x8000）。
#   ❗ 不要写 kmod-mt76 / kmod-mt76-core / kmod-mt7603-common =n —— 那是纯有线机型的写法。
#   ❗ 闭源 mt_wifi（kmod-mt7615d / luci-app-mtwifi）必须 =n：那是 MT7615 的东西，
#      本机没有该芯片，纯粹防上游 DEFAULT_PACKAGES 误拉。
CONFIG_PACKAGE_kmod-mt7603=y
CONFIG_PACKAGE_kmod-mt76x2=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mt7615e=n
CONFIG_PACKAGE_kmod-mt7615-firmware=n
CONFIG_PACKAGE_kmod-mt7615d=n
CONFIG_PACKAGE_luci-app-mtwifi=n
#   wpad：只要 WPA2-PSK。wpad-basic 比 target.mk 默认的 wpad-openssl 省约 100KB，
#   11ac/11n 能力由 hostapd 的 CONFIG_IEEE80211AC 决定，与 SSL 后端无关。
#   ❗ 必须同时在 diy-part2.sh 给 youhua_wr1200js 的 DEVICE_PACKAGES 加 -wpad-openssl，
#     否则 DEFAULT_PACKAGES 会把它当默认 y 拽回来（改源头才彻底）。
CONFIG_PACKAGE_wpad-basic=y
CONFIG_PACKAGE_wpad-openssl=n
CONFIG_PACKAGE_wpad-wolfssl=n
CONFIG_PACKAGE_wpad=n
CONFIG_PACKAGE_wpad-mini=n
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_hostapd-common=y
CONFIG_PACKAGE_libiwinfo=y
CONFIG_PACKAGE_libiwinfo-lua=y
CONFIG_PACKAGE_libiwinfo-data=y
CONFIG_PACKAGE_iwinfo=y

# ===== 有线/拨号 =====
# swconfig：本机是 DSA，用不到；但它在 target.mk 的 DEFAULT_PACKAGES 里，
#   强压 =n 收益仅 ~10k 且要盯 kconfig，留着无害。
CONFIG_PACKAGE_swconfig=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y
# PPPoE：当主路由拨号必需（ppp + ppp-mod-pppoe ≈ 105KB 安装）。
# 只当 AP / 旁路由时把三行改 =n，可再省约 35KB 镜像。
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y
# IPv6：不开（省 odhcp6c/odhcpd ≈ 30KB）
CONFIG_PACKAGE_odhcp6c=n
CONFIG_PACKAGE_odhcpd=n

# ===== USB：整条链全灭 =====
#   为什么砍：上游 DEVICE_PACKAGES 带 kmod-usb3 + kmod-usb-ledtrig-usbport，
#   已由 diy-part2.sh 第 [21] 段从 mt7621.mk 里剔掉。理由是没有 opkg，
#   装不了 usb-storage / kmod-fs-*，插 U 盘也用不了，留着白占 ~40k。
#   ❗ 想保留 U 盘能力（恢复 extroot 退路）：把 diy-part2 第 [21] 段那行的
#      DEVICE_PACKAGES 改回带 kmod-usb3 kmod-usb-ledtrig-usbport，并把下面
#      kmod-usb-core/2/3/ehci、kmod-usb-storage、kmod-fs-ext4/vfat、block-mount 改 =y。
CONFIG_PACKAGE_kmod-usb-core=n
CONFIG_PACKAGE_kmod-usb2=n
CONFIG_PACKAGE_kmod-usb3=n
CONFIG_PACKAGE_kmod-usb-ehci=n
CONFIG_PACKAGE_kmod-usb-ohci=n
CONFIG_PACKAGE_kmod-usb-dwc2=n
CONFIG_PACKAGE_kmod-usb-storage=n
CONFIG_PACKAGE_kmod-usb-storage-extras=n
CONFIG_PACKAGE_kmod-usb-storage-uas=n
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=n
CONFIG_PACKAGE_kmod-usb-hid=n
CONFIG_PACKAGE_kmod-usb-net=n
CONFIG_PACKAGE_kmod-usb-serial=n
CONFIG_PACKAGE_usbutils=n
CONFIG_PACKAGE_usb-modeswitch=n
CONFIG_PACKAGE_libusb-1.0=n
CONFIG_PACKAGE_block-mount=n
CONFIG_PACKAGE_kmod-scsi-core=n
CONFIG_PACKAGE_kmod-fs-ext4=n
CONFIG_PACKAGE_kmod-fs-vfat=n
CONFIG_PACKAGE_kmod-fs-ntfs=n
CONFIG_PACKAGE_kmod-fs-f2fs=n
CONFIG_PACKAGE_e2fsprogs=n
CONFIG_PACKAGE_fdisk=n
CONFIG_PACKAGE_lsblk=n
CONFIG_PACKAGE_luci-app-hd-idle=n

# ===== 其它常见拖体积项：显式关掉 =====
CONFIG_PACKAGE_libustream-wolfssl=n
CONFIG_PACKAGE_libwolfssl=n
CONFIG_PACKAGE_luci-app-diskman=n
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-rclone=n
CONFIG_PACKAGE_luci-app-turboacc=n
CONFIG_PACKAGE_luci-app-filetransfer=n
CONFIG_PACKAGE_luci-lib-fs=n
CONFIG_PACKAGE_luci-app-cpufreq=n
# ubi-utils：FEATURES 带 nand 时会进 DEFAULT_PACKAGES，本机是 SPI NOR。
#   ❗ 只写 =n 没用，真正生效的是 diy-part2.sh 第 [20] 段对 mt7621 的 FEATURES 去 nand。
CONFIG_PACKAGE_ubi-utils=n
# FTP/SIP/IRC/H.323 等 conntrack helper（≈53KB）：家用不需要 ALG
CONFIG_PACKAGE_kmod-nf-nathelper-extra=n
# MPPE 是 PPTP/VPN 的 PPP 加密，PPPoE 用不到（≈30KB 安装）
CONFIG_PACKAGE_kmod-mppe=n
# ip-full -> ip-tiny：tproxy 只用到 ip rule/ip route，顺带甩掉 libbpf0+libelf1（≈300KB 安装）
#   ❗ 必须同时在 diy-part2.sh 第 [20] 段把 ssr-plus 的 +ip-full 改成 +ip-tiny
CONFIG_PACKAGE_ip-tiny=y
CONFIG_PACKAGE_ip-full=n

# =====================================================================================
# 转发性能 / offload（硬件 offload 已启用：自用机，不需要流量统计与 QoS）
# =====================================================================================
#   驱动侧 CONFIG_NET_RALINK_OFFLOAD=y；下发侧 fw3 flow_offloading_hw=1 → FLOWOFFLOAD --hw。
#   kmod-nf-flow 的 KCONFIG 同时置位 CONFIG_NF_FLOW_TABLE(_HW)，缺 HW 时 --hw 静默退化。
#   注入点见 diy-part2.sh 第 [17] 段（门控已含 wr1200js）。
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_kmod-nf-flow=y

# ===== 依赖自洽兜底：kmod-mii（不改体积，防打包阶段炸）=====
#   kmod-usb-net 的 DEPENDS 有 +kmod-mii；本分支 generic/config-5.4 是 CONFIG_MII=y（内建），
#   mii.ko 不产出 → 只要有路径把 kmod-usb-net 拉进 .config 就 Error 1。置 y 拆雷。
CONFIG_PACKAGE_kmod-mii=y
