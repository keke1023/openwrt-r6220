# YouHua WR1200JS（ramips/mt7621）—— openwrt-18.06-k5.4 分支，纯 16MB SPI NOR 精简版
#
#   - 16MB SPI NOR（DTS: mt7621_youhua_wr1200js.dts，firmware 分区 0x50000+0xfb0000 = 16064k）
#   - 无线：开源 mt76 驱动（kmod-mt7603 2.4G + kmod-mt76x2 5G，PCIe 双芯片）
#   - 默认设备包带 USB3（kmod-usb3 / kmod-usb-ledtrig-usbport），已由 diy-part2.sh 第7段从源头剔除
#   - 用户约束：去 ssh/opkg、仅 ss/vless、去 USB；沿用 openwrt-16mb-slim skill 的精简清单
#   - 18.06-k5.4 兼容 helloworld/ngrokc（diy-part1.sh 对 openwrt-18.06-k* 放行），故带 ssr-plus + ngrokc
#   - 仅真正老内核 openwrt-18.06（4.x）才跳过 helloworld

# ===== 目标设备（铁律：CONFIG_TARGET_<target>_<subtarget>_DEVICE_<device>=y） =====
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_youhua_wr1200js=y

# ===== 编译/镜像级优化（小闪存核心） =====
CONFIG_TARGET_OPTIMIZE_FOR_SIZE=y
CONFIG_TARGET_SQUASHFS_XZ=y

# ===== 用户明确不要的功能 =====
CONFIG_PACKAGE_dropbear=n                       # 不要 SSH
CONFIG_PACKAGE_opkg=n                           # 不要 opkg 包管理
CONFIG_PACKAGE_luci-app-opkg=n                  # opkg 的 LuCI 前端

# ===== LuCI（走纯 http，去掉 SSL 以省空间） =====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=n
CONFIG_PACKAGE_libustream-mbedtls=n
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y

# ===== 无线（开源 mt76，由设备 DEVICE_PACKAGES 带入；此处显式确认） =====
CONFIG_PACKAGE_kmod-mt7603=y                    # 2.4G (MT7603E, PCIe)
CONFIG_PACKAGE_kmod-mt76x2=y                    # 5G (MT76x2, PCIe)
# 注：设备 profile 已强制 kmod-mt7603 kmod-mt76x2；此处=y 仅为显式声明，不影响体积

# ===== 用户指定插件（与 23.05 机型一致） =====
# -- luci-app-ssr-plus（来自 diy-part1.sh 添加的 fw876/helloworld 源；仅 ss+vless） --
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Client=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_MosDNS=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_V2ray=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Kcptun=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NaiveProxy=n

# -- luci-app-ngrokc（用户需要保留） --
CONFIG_PACKAGE_luci-app-ngrokc=y

# -- 不要 frpc：既不是 ssh/opkg，也不是 ss/vless 协议，且占空间 --
# CONFIG_PACKAGE_luci-app-frpc is not set

# ===== 剔除默认附加包（immortalwrt tweak 全家桶 + 无用的 TLS 链） =====
# —— 基础默认包 DEFAULT_PACKAGES 微调 ——
CONFIG_PACKAGE_uclient-fetch=n                  # 整条 TLS 链，无 opkg 后无用
CONFIG_PACKAGE_libustream-openssl=n             # 去掉 openssl/libustream（无 https 需求）
CONFIG_PACKAGE_ca-bundle=n
CONFIG_PACKAGE_logd=n                           # 日志环形缓冲，可省

# —— immortalwrt tweak 全家桶 DEFAULT_PACKAGES.tweak 微调 ——
CONFIG_PACKAGE_luci-lib-ipkg=n                  # LuCI 的 ipkg 库（无 opkg 后无用）
CONFIG_PACKAGE_luci-lib-fs=n                    # LuCI 文件浏览器后端
CONFIG_PACKAGE_luci-app-cpufreq=n               # CPU 频率调节页
CONFIG_PACKAGE_luci-app-filetransfer=n          # LuCI 文件上传/下载
CONFIG_PACKAGE_block-mount=n                    # 纯 SPI 无 USB 存储，去掉（红线3：先确认 DTS 无 USB → 已确认有 USB 但已从源头剔除，故可去）
CONFIG_PACKAGE_kmod-nf-nathelper-extra=n        # TFTP/SIP 等 ALG，家用不需要

# ===== USB 驱动/工具（用户不需要，diy-part2.sh 第7段已从设备 profile 源头剔除；此处再保险） =====
CONFIG_PACKAGE_kmod-usb-core=n
CONFIG_PACKAGE_kmod-usb2=n
CONFIG_PACKAGE_kmod-usb3=n
CONFIG_PACKAGE_kmod-usb-storage=n
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=n

# ===== IPv4-only（CONFIG_IPV6=n 自动连带剔除 odhcpd/odhcp6c/6in4/6rd/ds-lite/map/kmod-ip6tables） =====
CONFIG_IPV6=n

# ===== 保留（红线，不可动） =====
CONFIG_PACKAGE_dnsmasq-full=y                   # ssr-plus 硬依赖 ipset，绝不能降级为 base
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_luci-app-turboacc=y              # 保留 TurboACC：MT7621 千兆线速 NAT offload

# ===== 默认管理地址 192.168.6.1（由 scripts/diy-part2.sh 统一 sed 设置） =====
# CCACHE（workflow 也会再追加一次，这里写上也无害）
CONFIG_CCACHE=y
