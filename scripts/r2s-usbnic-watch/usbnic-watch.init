#!/bin/sh /etc/rc.common
# /etc/init.d/usbnic-watch
# 守护 NanoPi R2S 的 USB 网口（eth1 / WAN）：掉线取证 + 分级恢复。
# 只做取证与"能救就救"，不会重启系统（软重启本就救不回这颗芯片）。

START=99
STOP=10
USE_PROCD=1

start_service() {
	local enabled
	enabled=$(uci -q get usbnic-watch.main.enabled)
	[ "$enabled" = "0" ] && return 0

	procd_open_instance
	procd_set_param command /bin/sh /usr/sbin/usbnic-watch
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger usbnic-watch
}
