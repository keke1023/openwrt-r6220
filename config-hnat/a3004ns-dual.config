# ipTIME A3004NS-dual —— padavanonly/immortalwrt @ master（MTK SDK 驱动 + HNAT）
#
#   硬件：MT7621A / 256MB DDR3 / **16MB SPI NOR** / MT7602E(2.4G) + MT7612E(5G) / 4LAN+1WAN
#   本配置目标：**纯有线** + **MT7621 硬件 NAT（HNAT/PPE）** + ssr-plus(187-2) + xray v1.8.24
#
# ============================================================================
# 为什么用 padavanonly 的 master 而不是官方分支（已逐项核对源码）
# ============================================================================
#   mt7621.dtsi 里有硬件加速节点：
#       hnat: hnat@1e100000 { compatible = "mediatek,mtk-hnat_v1"; reg = <0x1e100000 0x3000>;
#                             resets = <&ethsys 0>; status = "disabled"; };
#   mt7621/config-5.10 里：
#       CONFIG_NET_MTKSDK=y            ← 用 MTK SDK 版以太网驱动顶掉主线 mtk_eth_soc
#       CONFIG_NET_MEDIATEK_HNAT=m     ← HNAT 驱动（源码见 mediateksdk/mtk_hnat/）
#       CONFIG_NET_DSA=y / DSA_MT7530=y / DSA_TAG_MTK=y
#   打包在 target/linux/ramips/modules.mk:137 → KernelPackage/ramips_hnat
#       （即 kmod-ramips_hnat，FILES 指向 mtkhnat.ko）
#   mediateksdk/Kconfig: NET_MEDIATEK_HNAT 明写支持 MT7621 chipset family
#   hnat_stag.c（STAG = Special Tag）只在 CONFIG_NET_DSA_MT7530=y 时编译 —— MT7621 专有机制
#   官方 openwrt master 的 mt7621.dtsi **没有** hnat 节点，所以这条路只有该分支能走。
#
# ⚠️ 与 18.06 的 ralink mtk_offload.c 不是一回事：
#   18.06 那份是把 PPE 注册进 nf_flow_table 的硬件档（fw3 的 FLOWOFFLOAD --hw）；
#   这里是 MTK SDK 自己的 FOE 表 + STAG，走 dts probe，**不经过 nf_flow_table**。
#   两者不能共存，故本配置**不选** kmod-ipt-offload / kmod-nf-flow。
#
# ============================================================================
# ⚠️ 三个必须由 diy 脚本落地、config 写不进来的点（见 scripts/hnat-part2.sh）
# ============================================================================
#  1) HNAT 是 =m，由 **kmod-ramips_hnat** 打包
#     （target/linux/ramips/modules.mk:137 的 KernelPackage/ramips_hnat，
#       FILES = mediateksdk/mtk_hnat/mtkhnat.ko）。
#     保持模块形态而不是内建，是为了能 rmmod 回退（HNAT 绕过 netfilter，
#     万一和 ssr-plus 的 TPROXY 打架，ssh 进 LAN 口执行 hnat-ctl stop 即可）。
#     hnat-part2.sh 会：① 若被改成 =y 则纠回 =m；② 校验 KernelPackage 存在；
#     ③ 写入 /etc/modules.d/60-mtkhnat 让它开机加载；④ 装 /usr/sbin/hnat-ctl。
#  2) dts 里 hnat 节点是 status="disabled"，而且**只写 status 不够**：
#     hnat_probe() 对 mtketh-wan 与 mtketh-max-gmac 是硬失败（源码 hnat.c:718/747），
#     缺任一个就 return -EINVAL，dmesg 无有效信息、debugfs 不出现、加速静默不生效。
#     hnat-part2.sh 追加的完整节点：
#        &hnat { mtketh-wan = "wan"; mtketh-lan = "lan"; mtketh-ppd = "eth0";
#                mtketh-max-gmac = <1>; mtkdsa-wan-port = <0>; status = "okay"; };
#     （本机 DSA：wan = port@0，lan1-4 = port@1..4；hnat.h 的 IS_DSA_WAN/IS_DSA_LAN
#       按 "wan"/"lan" 前缀匹配；mtkdsa-wan-port 是启用 DSA STAG 路径的开关）
#  3) 无线：本机型 dts 把 &pcie0/&pcie1 都 status="okay" 挂了 mt76，
#     光在 config 里关包不够，hnat-part2.sh 还会把 mt7621.mk 的 DEVICE_PACKAGES
#     里 kmod-mt76x2 / kmod-usb3 / kmod-usb-ledtrig-usbport 一并摘掉。
#
# ============================================================================
# ⚠️ 网络架构与 18.06 不同：这是 **DSA**（$(Device/dsa-migration)），不是 swconfig
# ============================================================================
#   网口是独立 netdev（wan / lan1-4），没有 switch/vlan 段。
#   首次刷入后 /etc/config/network 与防火墙 zone 都要按新设备名重配。
#
# ============================================================================
# ⚠️ 体积账（16MB 芯片，firmware 分区 reg = <0x40000 0xfc0000> = 16128k ≈ 15.75MiB）
# ============================================================================
#   基础系统(无wifi/无usb) ≈4.0 + luci 最小+中文 ≈2.3 + ssr-plus ≈0.3
#   + xray v1.8.24 ≈5.6 + ss 栈 ≈0.1 + mediateksdk/HNAT 内核部分 ≈0.3  ≈ 12.6MiB
#   余约 3MiB 给 overlay。与 18.06 版基本持平（DSA 与 SDK 驱动都不大，
#   master 默认没有 nftables/fw4，反而比 23.05 省）。
#
# ⚠️ TLS 后端单一化：master 默认 libustream-openssl（见 include/target.mk）。
#   本配置沿用默认 openssl 后端，**不要**同时选 libustream-mbedtls，否则
#   两者都提供 lib/libustream-ssl.so → opkg check_data_file_clashes 失败。

# ===== 目标设备（铁律：subtarget 不可省）=====
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_iptime_a3004ns-dual=y

# ===== 镜像 =====
CONFIG_TARGET_OPTIMIZE_FOR_SIZE=y
CONFIG_TARGET_SQUASHFS_XZ=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# initramfs 保留：首次从原厂/PandoraBox Web 界面刷入要用它
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_CCACHE=y

# ===== LuCI（最小集）=====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
# 防火墙：本分支 DEFAULT_PACKAGES.router 是 firewall + iptables（18.06 的 fw3 生态），
# ssr-plus 也走 Iptables_Transparent_Proxy。firewall4（nftables）与本组合互斥，
# 它的 CONFLICTS 会和 kmod-ipt-nat 互锁成 kconfig 环，hnat-part2.sh [0] 段会删掉该目录。
# 这里显式钉住 fw3，避免 defconfig 的默认值漂移。
CONFIG_PACKAGE_firewall=y
CONFIG_PACKAGE_firewall4=n
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-filetransfer=n
CONFIG_PACKAGE_luci-lib-fs=n
CONFIG_PACKAGE_luci-app-cpufreq=n
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_luci-app-ttyd=n

# ===== 管理基础 =====
# dropbear 保留：failsafe 的 failsafe_netlogin() 依赖 dropbearkey/dropbear，
# 删了就只能靠串口（本机无串口引出），省 30KB 不值这个风险。
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_opkg=y
# ssr-plus 硬依赖 ipset，dnsmasq 不能降级为精简版
CONFIG_PACKAGE_dnsmasq-full=y

# ===== 中断均衡：irqbalance =====
# MT7621 是 4 核，但 GMAC 中断默认全压在 CPU0（实测 NET_RX 分布 cpu0 占 82%）。
# irqbalance 按负载把中断分散到其余核，对两件事有实际收益：
#   1) 未被 HNAT 卸载的流量（首包、UDP、代理连接）
#   2) v2ray 是单进程，必然吃死一个核；把中断挪开能避免和它抢同一个核
# 体积约 20KB，装 16MB 分区完全无压力。
CONFIG_PACKAGE_irqbalance=y

# ===== 代理：helloworld 187-2（a201839）+ xray v1.8.24 =====
# 具体 pin 与 xray 前移由 scripts/hnat-part1.sh 完成
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_Iptables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_V2ray=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan_Plus=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Kcptun=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_MosDNS=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_DNS2SOCKS=n
# Shadowsocks 客户端：choice，NONE 与 Libev 只能二选一（写两个 =y 会 out of sync）
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Client=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_NONE_Server=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Simple_Obfs=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ChinaDNS_NG=y
CONFIG_PACKAGE_xray-core=y

# ===== 无线：驱动/守护全关（本机纯有线）=====
#   关掉 mt76 链约省 1.2MiB，关 wpad 再省 0.4MiB。
#   注意 mt7621.mk 的 DEVICE_PACKAGES 里仍有 kmod-mt76x2，hnat-part2.sh 会摘掉；
#   仅靠这里写 =n 不够 —— DEVICE_PACKAGES 会把它拉回来。
CONFIG_PACKAGE_kmod-mt76x2=n
CONFIG_PACKAGE_kmod-mt76-core=n
CONFIG_PACKAGE_kmod-mt76-connac=n
CONFIG_PACKAGE_kmod-mac80211=n
CONFIG_PACKAGE_kmod-cfg80211=n
CONFIG_PACKAGE_kmod-mt7602e=n
CONFIG_PACKAGE_kmod-mt7612e=n
CONFIG_PACKAGE_wpad-basic=n
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_wpad-openssl=n
CONFIG_PACKAGE_wireless-regdb=n

# libiwinfo* 必须保留：luci 元包 LUCI_DEPENDS 硬依赖 +libiwinfo-lua，
# 强制 =n 会被 kconfig 翻回 y 并触发 out of sync（18.06 线实测踩过）。
# 这三个都是纯用户态库，不拉任何 kmod，与"无无线"不冲突。
CONFIG_PACKAGE_libiwinfo=y
CONFIG_PACKAGE_libiwinfo-lua=y
CONFIG_PACKAGE_libiwinfo-data=y
CONFIG_PACKAGE_iwinfo=n

# ===== USB / 存储：整条链关闭（纯有线，不用 U 盘）=====
# 副作用：失去 extroot 退路，overlay 只能落在 rootfs_data。
CONFIG_PACKAGE_kmod-usb-core=n
CONFIG_PACKAGE_kmod-usb2=n
CONFIG_PACKAGE_kmod-usb3=n
CONFIG_PACKAGE_kmod-usb-ehci=n
CONFIG_PACKAGE_kmod-usb-ohci=n
CONFIG_PACKAGE_kmod-usb-storage=n
CONFIG_PACKAGE_kmod-usb-storage-extras=n
CONFIG_PACKAGE_kmod-usb-storage-uas=n
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=n
CONFIG_PACKAGE_kmod-usb-hid=n
CONFIG_PACKAGE_kmod-usb-net=n
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=n
CONFIG_PACKAGE_kmod-usb-net-rtl8152=n
CONFIG_PACKAGE_kmod-usb-serial=n
CONFIG_PACKAGE_usbutils=n
CONFIG_PACKAGE_libusb-1.0=n
CONFIG_PACKAGE_block-mount=n
CONFIG_PACKAGE_kmod-scsi-core=n
CONFIG_PACKAGE_kmod-fs-ext4=n
CONFIG_PACKAGE_kmod-fs-vfat=n
CONFIG_PACKAGE_kmod-fs-ntfs=n
CONFIG_PACKAGE_kmod-fs-exfat=n
CONFIG_PACKAGE_kmod-fs-f2fs=n
CONFIG_PACKAGE_e2fsprogs=n
CONFIG_PACKAGE_fdisk=n
CONFIG_PACKAGE_lsblk=n
CONFIG_PACKAGE_luci-app-hd-idle=n

# ===== 拨号：本机是二级路由，WAN 走 DHCP，不需要 PPPoE =====
# 日后若改成主路由拨号，把这两项改回 =y 重编。
CONFIG_PACKAGE_ppp=n
CONFIG_PACKAGE_ppp-mod-pppoe=n

# ===== 其它拖体积项 =====
CONFIG_PACKAGE_odhcp6c=n
CONFIG_PACKAGE_odhcpd=n
CONFIG_PACKAGE_luci-app-diskman=n
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-rclone=n
CONFIG_PACKAGE_luci-app-turboacc=n
CONFIG_PACKAGE_luci-app-turboacc-mtk=n

# ===== 硬件加速：HNAT =====
# 内核侧保持 =m（KernelPackage 才能打包出 mtkhnat.ko 并可 rmmod 回退）；
# hnat-part2.sh 会核对 config-5.10 与 .config 两侧都不是 =y。
#   CONFIG_KERNEL_* 是真生效的：include/kernel-defaults.mk:108 把 .config 里的
#   CONFIG_KERNEL_X 改写成 CONFIG_X 追加进 .config.target，覆盖 config-5.10。
# DEBUG_FS 不用写：generic/config-5.10 已是 CONFIG_DEBUG_FS=y，
# hnat_debugfs.c 无条件编译，靠它输出 /sys/kernel/debug/hnat/ 供排查。
CONFIG_KERNEL_NET_MEDIATEK_HNAT=m
# 走 KernelPackage/ramips_hnat；它的 KCONFIG 还会带进 BRIDGE_NETFILTER=y
# 与 NETFILTER_FAMILY_BRIDGE=y（generic 里本来没有，靠它才进内核）。
CONFIG_PACKAGE_kmod-ramips_hnat=y
# 硬件 QoS（mtkhqos）本机不需要：不做限速/优先级，开了只会多占 FOE 表项。
# 分支里的 package/emortal/mt-drivers/mtkhqos_util 就是写 /sys/kernel/debug/hnat/
# 的 qdma_sch*/qos_toggle 来做整形；MT7621 是 HNAT V1（num_of_sch=2），
# 该脚本写 sch2/sch3 本来就会失败。要限速再开：CONFIG_PACKAGE_mtkhqos_util=y
CONFIG_KERNEL_NET_MEDIATEK_HW_QOS=n
# 明确不选 nf_flow_table 硬件档：它和 HNAT 抢同一条转发路径
CONFIG_PACKAGE_kmod-ipt-offload=n
CONFIG_PACKAGE_kmod-nf-flow=n

# ===== 依赖自洽兜底 =====
# kmod-mii：18.06 线曾因 kmod-usb-net 的 +kmod-mii 依赖在打包阶段失败。
# 本线 USB 全关，理论上不会触发；保留 =y 作为低成本保险（内建时不增体积）。
CONFIG_PACKAGE_kmod-mii=y
