# Phicomm K2P（16MB）—— padavanonly/immortalwrt @ master（MTK SDK 驱动 + HNAT）
#
#   硬件：MT7621A / 128MB DDR3 / **16MB SPI NOR** / MT7615D（DBDC，2.4G+5G 单芯片）/ 4LAN+1WAN
#   目标：**闭源无线** + **MT7621 硬件 NAT（HNAT/PPE）** + ssr-plus(187-2) + xray v1.8.24
#         + luci-app-ngrokc + luci-app-autoreboot
#
# ============================================================================
# 与 a3004ns-dual.config 的六处本质差异（不能照抄，照抄必挂）
# ============================================================================
#   | 维度            | a3004ns-dual          | K2P（本文件）              |
#   |-----------------|-----------------------|----------------------------|
#   | 交换            | DSA                   | **swconfig**               |
#   | dts 的 &hnat    | 无，需脚本追加        | **已有，一个字都不能改**   |
#   | mtketh-wan      | "wan"（DSA label）    | "eth1"（独立 gmac1）       |
#   | max-gmac        | <1>                   | <2>                        |
#   | mtkdsa-wan-port | 必须有 <0>            | **必须没有**（否则按 DSA 填 STAG，端口错）|
#   | ext-devices     | 必须没有              | **必须有**（8 个闭源无线接口）|
#   | swconfig 包     | 剔除                  | **必须保留**（VLAN 靠它）  |
#   | wireless-tools  | 剔除                  | **必须保留**（mt_wifi 硬依赖）|
#
#   证据（mt7621_phicomm_k2p.dts，上游原样）：
#     &switch0 { /delete-property/ compatible; };   ← 删 DSA compatible，转 swconfig
#     &gsw { mediatek,portmap = "llllw"; ... };     ← 5 口全在 MT7530 上
#     &gmac0 → eth0（LAN，经 port5 RGMII）
#     &gmac1 → eth1（WAN，经 port6 RGMII）
#     &hnat { mtketh-wan = "eth1"; mtketh-lan = "eth0"; mtketh-ppd = "eth0";
#             mtketh-max-gmac = <2>;
#             ext-devices = "wlan0","wlan1","rax0","ra0","rai0","apclii0","apclix0","apcli0";
#             status = "okay"; };
#   → 与 jcg_q20 同构（双 gmac + swconfig），这是分支内 13 个 HNAT 机型的主流写法。
#
# ============================================================================
# 闭源无线的三层结构（只选一层会得到「界面在、驱动不在」或「驱动在、无法配网」）
# ============================================================================
#   package/emortal/mt-drivers/mt7615d   → KernelPackage，产出 mt_wifi.ko（驱动本体）
#   package/emortal/mt-drivers/mt_wifi   → 纯配置文件包（/etc/wireless/mt7615/*.dat 等）
#                                          DEPENDS:=@TARGET_ramips +wireless-tools
#                                          ← 这就是 wireless-tools 不能剔的原因
#   package/emortal/luci-app-mtwifi      → LuCI 界面，LUCI_DEPENDS:=@TARGET_ramips +mt_wifi
#
#   上游 image/mt7621.mk 的 Device/phicomm_k2p 已经把前两层写进 DEVICE_PACKAGES：
#       DEVICE_PACKAGES := kmod-mt7615d luci-app-mtwifi
#   DEVICE_PACKAGES 是「强制加入」语义，所以 hnat-part2.sh [3] 段对 K2P **不清空**，
#   只校验它仍在（对 a3004ns 才清空）。
#
#   芯片变体不用手写：mt_wifi/config.in 与 mt7615d/config.in 里对 K2P 已全部
#   default y（TARGET_ramips_mt7621_DEVICE_phicomm_k2p）：
#       MTK_CHIP_MT7615E_DBDC / MTK_DBDC_MODE / MTK_MULTI_PROFILE_SUPPORT /
#       MTK_DEFAULT_5G_PROFILE / MTK_SECOND_IF_NONE
#   只要 DEVICE_phicomm_k2p=y，双频 DBDC 就是对的。下面显式写出来是为了防默认值漂移。
#
# ============================================================================
# ⚠️ 体积账（16MB 芯片，firmware 分区 reg = <0x50000 0xfb0000> = 16064k ≈ 15.69MiB）
# ============================================================================
#   参照 a3004ns 实测 12.25MiB（含 xray 5.6），K2P 额外要装：
#     闭源无线 mt_wifi.ko          ≈ +0.9   （压缩后）
#     mt_wifi 配置 + mtwifi 界面    ≈ +0.1
#     wpad-basic                   ≈ +0.2   （openssl 后端已在，不额外拉 ssl 库）
#     mac80211 + cfg80211          ≈ +0.3
#     ngrokc + libstdcpp           ≈ +0.4
#     autoreboot                   ≈ +0.02
#     ppp + ppp-mod-pppoe          ≈ +0.1
#   ≈ 14.1MiB，再靠 squashfs 块 1024（xz 字典更大，普遍再省 3~8%）留出余量。
#   若实测超 16064k，优先砍 ppp（改回 =n 即二级路由形态）和 vmess/trojan 支持。
#
# ⚠️ TLS 后端单一化：本分支默认 libustream-openssl，**不要**再选 libustream-mbedtls，
#   否则两个包都提供 lib/libustream-ssl.so → opkg check_data_file_clashes 失败。

# ===== 目标设备（铁律：subtarget 不可省）=====
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_phicomm_k2p=y

# ===== 镜像 =====
CONFIG_TARGET_OPTIMIZE_FOR_SIZE=y
CONFIG_TARGET_SQUASHFS_XZ=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# 1024k 块：build.yml 有硬校验（k2p 必须 =1024），xz 字典更大、镜像更小
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=1024
# initramfs 保留：Breed / 原厂 Web 救砖时能直接跑内存系统，不占 squashfs 体积
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_CCACHE=y

# ===== LuCI（最小集 + 中文）=====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
# 防火墙：本分支 DEFAULT_PACKAGES.router 是 fw3 + iptables（18.06 生态），
# ssr-plus 也走 Iptables_Transparent_Proxy。firewall4（nftables）与之互斥，
# 它的 CONFLICTS 会和 kmod-ipt-nat 互锁成 kconfig 环，hnat-part2.sh [0] 段删该目录。
CONFIG_PACKAGE_firewall=y
CONFIG_PACKAGE_firewall4=n
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
# 无关界面一律不要（挂在 target DEFAULT_PACKAGES 上的那批，显式 =n 能压住）
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_luci-app-oaf=n
CONFIG_PACKAGE_luci-app-ttyd=n
CONFIG_PACKAGE_luci-app-cpufreq=n
CONFIG_PACKAGE_luci-app-filetransfer=n
CONFIG_PACKAGE_luci-lib-fs=n
CONFIG_PACKAGE_luci-app-diskman=n
CONFIG_PACKAGE_luci-app-hd-idle=n
CONFIG_PACKAGE_luci-app-rclone=n
CONFIG_PACKAGE_luci-app-turboacc=n
CONFIG_PACKAGE_luci-app-turboacc-mtk=n

# ===== 管理基础 =====
# dropbear 保留：failsafe 的 failsafe_netlogin() 依赖它，删了只能靠串口（K2P 无引出）
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_opkg=y
# ssr-plus 硬依赖 ipset，dnsmasq 不能降级为精简版
CONFIG_PACKAGE_dnsmasq-full=y

# ===== 中断均衡 =====
# MT7621 四核，GMAC 中断默认全压 CPU0；irqbalance 把中断摊开，
# 对未被 HNAT 卸载的流量（首包 / UDP / 代理连接）有实际收益。约 20KB。
CONFIG_PACKAGE_irqbalance=y

# ===== 闭源无线：MT7615D DBDC（三层都要，缺一层功能不全）=====
# 驱动本体（mt_wifi.ko）。mt7621.mk 的 DEVICE_PACKAGES 也会拉，显式写便于自查
CONFIG_PACKAGE_kmod-mt7615d=y
# 用户态配置（/etc/wireless/mt7615/*.dat、l1profile、load 脚本），DEPENDS +wireless-tools
CONFIG_PACKAGE_mt_wifi=y
# LuCI 界面（网络 → MTK WiFi）
CONFIG_PACKAGE_luci-app-mtwifi=y
# 芯片变体：K2P 是单芯片 DBDC（2.4G + 5G 同一颗），不是两片独立芯片
CONFIG_MTK_CHIP_MT7615E_DBDC=y
CONFIG_MTK_DBDC_MODE=y
CONFIG_MTK_MULTI_PROFILE_SUPPORT=y
CONFIG_MTK_DEFAULT_5G_PROFILE=y

# 加密前端：闭源驱动不做 WPA 握手，靠 wpad（hostapd+supplicant 合并包）
# 18.06 的变体是 wpad-basic（openssl 后端），**不是** wpad-basic-wolfssl。
# target/linux/ramips/mt7621/target.mk 的 DEFAULT_PACKAGES 里塞的是 wolfssl 变体，
# 两者都 PROVIDES wpad，同时存在会冲突，所以这里显式钉住。
CONFIG_PACKAGE_wpad-basic=y
CONFIG_PACKAGE_wpad-basic-wolfssl=n
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_wpad-openssl=n
CONFIG_PACKAGE_wpad-wolfssl=n
CONFIG_PACKAGE_wpad-mini=n
# 无线子系统：wpad / iwinfo 需要 cfg80211 的 nl80211 接口才能枚举与显示
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-cfg80211=y
# mt_wifi 的硬依赖（DEPENDS:=@TARGET_ramips +wireless-tools），剔了它就装不上配置
CONFIG_PACKAGE_wireless-tools=y

# 开源 mt76 必须全关：与闭源 mt_wifi 抢同一张 PCI 卡（dts 的 pcie0 节点
# compatible="mediatek,mt76"，开源驱动一在就会先绑上去，闭源驱动拿不到设备）
CONFIG_PACKAGE_kmod-mt7615e=n
CONFIG_PACKAGE_kmod-mt7615-firmware=n
CONFIG_PACKAGE_kmod-mt76=n
CONFIG_PACKAGE_kmod-mt76-core=n
CONFIG_PACKAGE_kmod-mt76-connac=n
CONFIG_PACKAGE_kmod-mt76x2=n
CONFIG_PACKAGE_kmod-mt7603=n
CONFIG_PACKAGE_kmod-mt7602e=n
CONFIG_PACKAGE_kmod-mt7612e=n

# libiwinfo* 必须保留：luci 元包 LUCI_DEPENDS 硬依赖 +libiwinfo-lua，
# 强制 =n 会被 kconfig 翻回 y 并触发 out of sync（18.06 线实测踩过 Error 255）。
CONFIG_PACKAGE_libiwinfo=y
CONFIG_PACKAGE_libiwinfo-lua=y
CONFIG_PACKAGE_libiwinfo-data=y
CONFIG_PACKAGE_iwinfo=y

# ===== 内网穿透：ngrokc（自带 luci 前端）=====
# 两层都要：ngrokc 是后端二进制（DEPENDS +libstdcpp +libopenssl +zlib，约 400KB），
# luci-app-ngrokc 只是界面。只选界面会得到一个点不动的菜单。
CONFIG_PACKAGE_ngrokc=y
CONFIG_PACKAGE_luci-app-ngrokc=y

# ===== 定时重启 =====
# 纯 Lua 界面 + 一条 cron，体积可忽略（约 20KB）。
# 注意它依赖 luci-compat（18.06 接口），kconfig 会自动带入。
CONFIG_PACKAGE_luci-app-autoreboot=y

# ===== 代理：helloworld 187-2（a201839）+ xray v1.8.24 =====
# pin 与 xray 前移由 scripts/hnat-part1.sh 完成（与机型无关，K2P 复用同一套）
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_Iptables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_V2ray=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan_Plus=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Kcptun=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_MosDNS=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_DNS2SOCKS=n
# Shadowsocks 客户端：choice，NONE 与 Libev 只能二选一（同写 =y 会 out of sync）
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Client=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_NONE_Server=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Simple_Obfs=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ChinaDNS_NG=y
CONFIG_PACKAGE_xray-core=y

# ===== 拨号：K2P 常作主路由，PPPoE 必须留着 =====
# 与 a3004ns（二级路由，剔掉）不同：删了 ppp 就只能挂在别人后面当 AP 用。
# 约 130KB，是这套里性价比最高的保留项。
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# ===== IPv6：保留，无线客户端要用 =====
# odhcp6c 不剔：ramips 的 DEFAULT_PACKAGES 有 ipv6helper，它硬依赖 odhcp6c，
# 压成 =n 会被 kconfig 求解翻回 =y（run 42371798195 就是这么被拦下的）。
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd=y

# ===== USB / 存储：K2P 没有 USB 口，整条链关掉 =====
CONFIG_PACKAGE_kmod-usb-core=n
CONFIG_PACKAGE_kmod-usb2=n
CONFIG_PACKAGE_kmod-usb3=n
CONFIG_PACKAGE_kmod-usb-ehci=n
CONFIG_PACKAGE_kmod-usb-ohci=n
CONFIG_PACKAGE_kmod-usb-uhci=n
CONFIG_PACKAGE_kmod-usb-storage=n
CONFIG_PACKAGE_kmod-usb-storage-extras=n
CONFIG_PACKAGE_kmod-usb-storage-uas=n
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=n
CONFIG_PACKAGE_kmod-usb-hid=n
CONFIG_PACKAGE_kmod-usb-net=n
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=n
CONFIG_PACKAGE_kmod-usb-net-rtl8152=n
CONFIG_PACKAGE_kmod-usb-serial=n
CONFIG_PACKAGE_usbutils=n
CONFIG_PACKAGE_libusb-1.0=n
CONFIG_PACKAGE_libusb-compat=n
CONFIG_PACKAGE_usb-modeswitch=n
CONFIG_PACKAGE_block-mount=n
CONFIG_PACKAGE_kmod-scsi-core=n
CONFIG_PACKAGE_kmod-fs-ext4=n
CONFIG_PACKAGE_kmod-fs-vfat=n
CONFIG_PACKAGE_kmod-fs-ntfs=n
CONFIG_PACKAGE_kmod-fs-exfat=n
CONFIG_PACKAGE_kmod-fs-f2fs=n
CONFIG_PACKAGE_e2fsprogs=n
CONFIG_PACKAGE_fdisk=n
CONFIG_PACKAGE_lsblk=n

# ===== 被 DEFAULT_PACKAGES 硬塞进来、本机用不上的包 =====
# 依据：target/linux/ramips/mt7621/target.mk 的
#   DEFAULT_PACKAGES += wpad-basic-wolfssl swconfig kmod-ramips_hnat wireless-tools \
#                       l1profile luci-app-upnp luci-app-oaf iptables-mod-ipopt \
#                       iptables-mod-conntrack-extra mtkhqos_util \
#                       luci-app-mwan3helper-chinaroute
# 以及 target/linux/ramips/Makefile 的 luci-app-eqos-mtk / luci-app-turboacc-mtk。
# 实测结论：**显式 =n 能压住 DEFAULT_PACKAGES**（turboacc-mtk 写 =n 就没进编译目录）。
#
# swconfig **不能剔**：K2P 是 swconfig 机型，VLAN 划分靠它（02_network 里
# ucidef_add_switch "switch0"）。a3004ns 是 DSA 才剔它。
CONFIG_PACKAGE_swconfig=y
# l1profile 保留：闭源无线的信道/功率 profile（mt_wifi/files/*.l1profile.dat）
# 它本来就在 DEFAULT_PACKAGES 里，不显式关。
# prism54/p54 是 Intersil 老无线网卡固件，与本机无关
CONFIG_PACKAGE_prism54-firmware=n
CONFIG_PACKAGE_p54-usb-firmware=n
CONFIG_PACKAGE_p54-pci-firmware=n
CONFIG_PACKAGE_p54-spi-firmware=n
# MTK 硬件 QoS 工具：**保留**（与 a3004ns 同一结论）
# 它开机往 /sys/kernel/debug/hnat/qdma_txq0..15 写 QTX_SCH/QTX_CFG 寄存器，
# 驱动侧默认值是否与脚本写的「不限速」等价没有证据；而它 Build/Compile 为空，
# 只装三个文本文件，体积可忽略。省这点体积去赌转发路径不划算。
CONFIG_PACKAGE_mtkhqos_util=y
# 但 QoS 的 LuCI 界面不需要，且它是 ebtables 三件套的唯一来源
CONFIG_PACKAGE_luci-app-eqos-mtk=n
CONFIG_PACKAGE_luci-app-mwan3helper-chinaroute=n
# ebtables 三件套只被 luci-app-eqos-mtk 依赖（LUCI_DEPENDS:=+ebtables +kmod-ebtables-ipv4/6）
CONFIG_PACKAGE_ebtables=n
CONFIG_PACKAGE_kmod-ebtables=n
CONFIG_PACKAGE_kmod-ebtables-ipv4=n
CONFIG_PACKAGE_kmod-ebtables-ipv6=n
# 其它无用项
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-passwall2=n
CONFIG_PACKAGE_luci-app-vssr=n
CONFIG_PACKAGE_luci-app-mwan3=n
CONFIG_PACKAGE_kmod-ipt-offload=n
CONFIG_PACKAGE_kmod-nf-flow=n

# ===== 硬件加速：HNAT =====
# 内核侧保持 =m（KernelPackage/ramips_hnat 才能打包出 mtkhnat.ko，且可 rmmod 回退）。
# CONFIG_KERNEL_* 真生效：include/kernel-defaults.mk 会把 .config 里的
# CONFIG_KERNEL_X 改写成 CONFIG_X 追加进 .config.target，覆盖 config-5.10。
CONFIG_KERNEL_NET_MEDIATEK_HNAT=m
# mt7621/target.mk 的 DEFAULT_PACKAGES 本来就有它，显式写便于自查
CONFIG_PACKAGE_kmod-ramips_hnat=y
# HW_QOS 是空壳开关（只在 mediateksdk/Kconfig 定义，mtk_hnat/ 零引用），
# 真正决定 QoS 的是运行时 /sys/kernel/debug/hnat/qos_toggle（初值 0 = 关）。
CONFIG_KERNEL_NET_MEDIATEK_HW_QOS=n

# ===== 依赖自洽兜底 =====
# kmod-mii：kmod-usb-net 的 +kmod-mii 曾在打包阶段制造依赖失败。
# 本配置 USB 全关，理论上不触发；内建时不增体积，留作低成本保险。
CONFIG_PACKAGE_kmod-mii=y
